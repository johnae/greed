# kubectl in the Greed shell: its rows are pods, after a filter too, with
# their actions a key away; table stages read the API's own fields, and a
# chart is one more stage.
size 1280 800
hide
run shell
wait-for ❯
show
wait 0.6
type kubectl get pods
keys enter
wait 1.5
type kubectl get pods | where STATUS != Running
keys enter
wait 1.5
keys esc
wait 0.4
keys j
wait 0.6
keys .
wait 1
type logs
wait 0.6
keys enter
wait 2.5
shot kubectl-logs
keys esc
wait 0.6
keys esc
wait 0.4
type kubectl get pods | chart RESTARTS
keys enter
wait 2.5
shot kubectl
wait 1
