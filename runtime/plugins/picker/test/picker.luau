local test = require("@kern/test")

test("the command palette runs the command you pick", function(t)
	t:buffer("|abc")
	t:keys("space ?")
	t:expect_mode("insert")
	local first = string.match(t:marked(), "\n> ([%w%-]+)")
	assert(first ~= nil, "the picker lists commands")

	t:keys("g o t o - e n d")
	local picked = string.match(t:marked(), "\n> ([%w%-]+)")
	assert(picked == "goto-end", "best match is goto-end, got " .. tostring(picked))

	t:keys("enter")
	t:expect_mode("normal")
	t:expect("abc|")
end)

test("up and down move through the matches", function(t)
	t:buffer("|abc")
	t:keys("space ?")
	local first = string.match(t:marked(), "\n> ([%w%-]+)")
	t:keys("down")
	local second = string.match(t:marked(), "\n> ([%w%-]+)")
	assert(second ~= first, "down moves to another item")
	t:keys("up")
	assert(string.match(t:marked(), "\n> ([%w%-]+)") == first, "up moves back")
end)

test("esc closes the picker without choosing", function(t)
	t:buffer("a|bc")
	t:keys("space ?")
	t:keys("esc")
	t:expect_mode("normal")
	t:expect("a|bc")
end)
