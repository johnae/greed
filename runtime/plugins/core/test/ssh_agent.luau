local test = require("@greed/test")
local greed = require("@greed")

test("with ssh-agent-confirm never, a key is used without asking", function(t)
	greed.option.set("ssh-agent-confirm", "never")
	local id = assert(t:ssh_agent_use("laptop"))
	assert(t:ssh_agent_answer(id) == true)
	for _, message in t:messages() do
		assert(not string.find(message, "ssh key", 1, true), message)
	end
end)

test("by default the first use on a client asks, and once allowed it doesn't again", function(t)
	assert(greed.option.get("ssh-agent-confirm") == "first")
	local first = assert(t:ssh_agent_use("laptop"))
	assert(t:ssh_agent_answer(first) == nil, "it waits for you")
	local asked = t:messages()
	assert(string.find(asked[#asked], "sign with your ssh key on laptop", 1, true), asked[#asked])
	t:keys("y")
	assert(t:ssh_agent_answer(first) == true)
	local second = assert(t:ssh_agent_use("laptop"))
	assert(t:ssh_agent_answer(second) == true, "allowed already")
	-- Another client is asked for itself.
	local other = t:client("other")
	local theirs = assert(other:ssh_agent_use())
	assert(t:ssh_agent_answer(theirs) == nil)
	other:keys("y")
	assert(t:ssh_agent_answer(theirs) == true)
end)

test("with always, every use asks", function(t)
	greed.option.set("ssh-agent-confirm", "always")
	local first = assert(t:ssh_agent_use())
	t:keys("y")
	assert(t:ssh_agent_answer(first) == true)
	local second = assert(t:ssh_agent_use())
	assert(t:ssh_agent_answer(second) == nil, "asked again")
	t:keys("y")
	assert(t:ssh_agent_answer(second) == true)
end)

test("any key but y refuses, and the next use asks again", function(t)
	local first = assert(t:ssh_agent_use())
	t:keys("n")
	assert(t:ssh_agent_answer(first) == false)
	local asked = t:messages()
	assert(asked[#asked] == "refused the ssh key", asked[#asked])
	local second = assert(t:ssh_agent_use())
	assert(t:ssh_agent_answer(second) == nil, "refusing isn't remembered")
	t:keys("esc")
	assert(t:ssh_agent_answer(second) == false)
end)

test("a second use while one asks waits its turn and takes its answer", function(t)
	local first = assert(t:ssh_agent_use())
	local second = assert(t:ssh_agent_use())
	assert(t:ssh_agent_answer(second) == nil)
	t:keys("y")
	assert(t:ssh_agent_answer(first) == true)
	assert(t:ssh_agent_answer(second) == true, "allowed with the first")
end)

test("answering a request nothing waits for says so", function()
	assert(greed.ssh_agent.answer(123456, true) == false)
end)
