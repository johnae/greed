local test = require("@kern/test")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	t:keys(keys)
	t:expect(after)
end

test('" picks a register for the next copy or paste; without one, the clipboard', function(t)
	t:buffer("^one| two")
	t:keys('" a y')
	t:buffer("^two| one")
	t:keys("y")
	t:buffer("x|")
	t:keys('" a p')
	t:expect("x^one|")
	t:keys("p")
	t:expect("xone^two|")
end)

test("d and c into a register leave the clipboard alone", function(t)
	t:buffer("^keep| x")
	t:keys("y")
	t:buffer("^gone| x")
	t:keys('" z d')
	t:buffer("|")
	t:keys("p")
	t:expect("^keep|")
	t:keys('" z p')
	t:expect("keep^gone|")
end)

test("Q records keys into a macro and q plays it, with counts", function(t)
	check(t, "|aa\nbb\ncc\ndd", "Q I - space esc j Q", "- aa\nbb|\ncc\ndd")
	t:keys("q")
	t:expect("- aa\n- bb\ncc|\ndd")
	t:keys("2 q")
	t:expect("- aa\n- bb\n- cc\n- |dd")
end)

test("macros go in the register picked before Q", function(t)
	local registers = require("@core").registers
	t:buffer("|x")
	t:keys('" m Q')
	assert(registers.recording() == "m", tostring(registers.recording()))
	t:keys("A ! esc Q")
	assert(registers.recording() == nil)
	t:expect("x!|")
	t:keys('" m q')
	t:expect("x!!|")
	t:keys("q")
	t:expect("x!!|")
	local messages = t:messages()
	assert(string.find(messages[#messages], "@", 1, true), messages[#messages])
end)

test("kern.keys records what's typed but not what's fed", function(t)
	local kern = require("@kern")
	t:buffer("|")
	kern.keys.record()
	assert(kern.keys.recording())
	t:keys("i a")
	kern.keys.feed("b")
	t:keys("esc")
	local keys = kern.keys.stop()
	assert(keys and table.concat(keys, " ") == "i a esc", table.concat(keys or {}, " "))
	assert(not kern.keys.recording() and kern.keys.stop() == nil)
	t:expect("ab|")
end)
