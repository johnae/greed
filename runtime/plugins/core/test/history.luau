local test = require("@kern/test")
local kern = require("@kern")

test("a buffer's history says who changed what, and for which command", function(t)
	t:buffer("hello |world")
	t:keys("i x esc")
	local buffer = kern.view():buffer()
	buffer:edit(function(e)
		e:insert(0, ">")
	end)
	local list = buffer:history()
	assert(#list == 2, `two transactions, not {#list}`)
	local latest, typed = list[1], list[2]
	assert(latest.author == "plugin" and latest.plugin ~= nil, latest.author)
	assert(typed.author == "user", typed.author)
	assert(typed.cause ~= nil, "typing has a cause")
	assert(typed.changes[1].from == 6 and typed.changes[1].text == "x", "the change")
	assert(buffer:text_before(typed.id) == "hello world", buffer:text_before(typed.id))
	assert(#buffer:history({ author = "user" }) == 1)
	assert(#buffer:history({ limit = 1 }) == 1)
	assert(buffer:text_before(123456) == nil)
end)

test("a command's edits carry its name, even after it waits", function(t)
	kern.command({
		name = "history-test-edit",
		run = function(ctx)
			kern.sleep(0)
			ctx.buffer:edit(function(e)
				e:insert(0, "a")
			end)
		end,
	})
	t:buffer("|")
	t:run("history-test-edit")
	t:wait(10)
	local entry = kern.view():buffer():history()[1]
	assert(entry.cause == "history-test-edit", tostring(entry.cause))
end)

test("a group undoes across buffers in one step", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a\n", ["b.txt"] = "b\n" })
	local a, b = kern.load(dir .. "/a.txt"), kern.load(dir .. "/b.txt")
	local group = kern.history.new_group()
	kern.history.set_group(group)
	for _, buffer in { a, b } do
		buffer:edit(function(e)
			e:insert(0, "!")
		end)
	end
	kern.history.set_group(nil)
	assert(a:history()[1].group == group)
	assert(kern.history.undo_group(group) == 2)
	assert(a:text() == "a\n" and b:text() == "b\n", a:text() .. b:text())
	assert(kern.history.undo_group(group) == 0, "nothing left to undo")
end)

test("a group with something on top of it stays", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a\n" })
	local a = kern.load(dir .. "/a.txt")
	local group = kern.history.new_group()
	kern.history.set_group(group)
	a:edit(function(e)
		e:insert(0, "!")
	end)
	kern.history.set_group(nil)
	a:edit(function(e)
		e:insert(0, "?")
	end)
	local n, why = kern.history.undo_group(group)
	assert(n == nil and why ~= nil and string.find(why, "changed since"), tostring(why))
	assert(a:text() == "?!a\n")
end)
