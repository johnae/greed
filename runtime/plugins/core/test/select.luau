local test = require("@greed/test")
local greed = require("@greed")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	t:keys(keys)
	t:expect(after)
end

test("% selects the whole buffer", function(t)
	t:buffer("a|b\ncd")
	t:keys("%")
	t:expect("^ab\ncd|")
end)

test("s selects every match inside the selections, and typing changes them all", function(t)
	t:buffer("^let x = foo(foo, bar);|")
	t:keys("s f o o enter")
	t:expect("let x = ^foo|(^foo|, bar);")
	t:keys("c b a z esc")
	t:expect("let x = baz|(baz|, bar);")
end)

test("s shows the matches while typing and puts things back on esc", function(t)
	t:buffer("^a1 b2|")
	local view = greed.view()
	t:keys("s [ 0 - 9 ]")
	assert(#view:selection().ranges == 2, "both digits are selected while typing")
	t:keys("esc")
	t:expect("^a1 b2|")
end)

test("S splits at matches, alt-s splits into lines", function(t)
	t:buffer("^a, b, c|")
	t:keys("S , space enter")
	t:expect("^a|, ^b|, ^c|")
	t:buffer("^one\ntwo|")
	t:keys("alt-s")
	t:expect("^one|\n^two|")
end)

test("K keeps the selections that match, alt-K removes them", function(t)
	t:buffer("^ab| ^cd| ^ae|")
	t:keys("K a enter")
	t:expect("^ab| cd ^ae|")
	t:buffer("^ab| ^cd| ^ae|")
	t:keys("alt-K a enter")
	t:expect("ab ^cd| ae")
end)

test("C adds a selection on the next line, at the same column", function(t)
	t:buffer("a|bc\ndef\ng")
	t:keys("C")
	t:expect("a|bc\nd|ef\ng")
	t:keys("C")
	t:expect("a|bc\nd|ef\ng|")
	t:keys("alt-C")
	t:expect("a|bc\nd|ef\ng|")
end)

test("C skips lines too short for the selection", function(t)
	t:buffer("ab|c\nd\nefg")
	t:keys("C")
	t:expect("ab|c\nd\nef|g")
	t:buffer("ab|c\nd")
	t:keys("C")
	t:expect("ab|c\nd")
end)

test(", keeps the primary selection, ( and ) move which one it is", function(t)
	t:buffer("^a| ^b| ^c|")
	t:keys(")")
	t:keys(",")
	t:expect("a ^b| c")
	t:buffer("^a| ^b| ^c|")
	t:keys("( alt-,")
	t:expect("^a| ^b| c")
end)

test("v starts select mode, where moves extend the selection", function(t)
	t:buffer("|one two three")
	t:keys("v w w")
	t:expect("^one two |three")
	t:expect_mode("select")
	t:keys("l l")
	t:expect("^one two th|ree")
	t:keys("v")
	t:expect_mode("normal")
end)

test("in select mode n adds the next match as another selection", function(t)
	t:buffer("|foo x foo y foo")
	t:keys("e * v n n")
	t:expect("^foo| x ^foo| y ^foo|")
	t:expect_mode("select")
end)

test("acting on the selection leaves select mode", function(t)
	t:buffer("|abc def")
	-- The character the cursor started on is part of the selection.
	t:keys("v l l d")
	t:expect("| def")
	t:expect_mode("normal")
end)

test("s with nothing typed uses the last search", function(t)
	t:buffer("|foo bar foo")
	t:keys("/ f o o enter % s enter")
	t:expect("^foo| bar ^foo|")
	t:keys("c z esc")
	t:expect("z| bar z|")
end)

test("X takes whole lines, alt-x only the whole lines inside", function(t)
	check(t, "a^b\nc|d\ne", "X", "^ab\ncd\n|e")
	check(t, "a^b\ncd\ne|f", "alt-x", "ab\n^cd\n|ef")
end)

test("alt-- merges every selection, alt-_ the ones that touch", function(t)
	t:buffer("^a| b ^c|")
	t:run("merge-selections")
	t:expect("^a b c|")
	check(t, "^a|^b| ^c|", "alt-_", "^ab| ^c|")
end)

test("_ trims spaces off the selections, & lines them up", function(t)
	check(t, "^ a |b", "_", " ^a| b")
	check(t, "|x = 1\nlonger |= 2", "&", "       |x = 1\nlonger |= 2")
end)

test("alt-( and alt-) rotate what the selections hold", function(t)
	check(t, "^a| ^b| ^c|", "alt-)", "^c| ^a| ^b|")
	check(t, "^a| ^b| ^c|", "alt-(", "^b| ^c| ^a|")
end)

test("ctrl-a and ctrl-x add to and subtract from the number at the cursor", function(t)
	check(t, "x = |41;", "ctrl-a", "x = ^42|;")
	check(t, "|x = 1, y = 9", "5 ctrl-x", "x = ^-4|, y = 9")
	check(t, "|0xff", "ctrl-a", "^0x100|")
end)

test("select mode lasts through selecting commands, and ends on an edit or a copy", function(t)
	t:buffer("|abc def\nghi")
	t:keys("v x")
	t:expect_mode("select")
	t:keys("y")
	t:expect_mode("normal")
	t:buffer("|abc def")
	t:keys("v % s a enter")
	t:expect_mode("select")
	t:keys("c z esc")
	t:expect_mode("normal")
end)
