	greed.fs.write(`{home}/notes.md`, "my notes\n")
	t:run("open", { "~/notes.md" })
	local buffer = greed.view():buffer()
	assert(buffer:path() == `{home}/notes.md`, tostring(buffer:path()))
	assert(buffer:text() == "my notes\n", buffer:text())
	t:run("save", { "~/copy.md" })
	assert(greed.fs.read(`{home}/copy.md`) == "my notes\n", "saved there")
end)

test("greed.fs takes ~ as the home folder everywhere", function()
	local home = assert(greed.fs.dirs().home)
	assert(greed.fs.mkdir("~/made"))
	assert(greed.fs.stat(`{home}/made`), "made in the home folder")
	assert(greed.fs.write("~/made/a.txt", "a\n"))
	assert(greed.fs.read("~/made/a.txt") == "a\n")
	assert(greed.fs.read_bytes("~/made/a.txt") == "a\n")
	assert((assert(greed.fs.stat("~/made/a.txt"))).kind == "file")
	assert(assert(greed.fs.list("~/made"))[1].name == "a.txt")
	assert(greed.fs.copy("~/made/a.txt", "~/made/b.txt"))
	assert(greed.fs.rename("~/made/b.txt", "~/made/c.txt"))
	assert(greed.fs.read(`{home}/made/c.txt`) == "a\n")
	assert(greed.fs.remove("~/made/c.txt"))
	assert(greed.fs.stat(`{home}/made/c.txt`) == nil)
	-- Only at the start, as a shell has it.
	assert(greed.fs.stat("~nobody/x") == nil)
end)

test("on-quit keeps the session while something runs, and as told", function()
	local file = require("@core").file
	local running = {}
	file.running("test", function()
		return running
	end)
	assert(not file.keeps(false), "nothing runs: auto ends it")
	assert(file.keeps(true), "over ssh it's kept by default")
	running = { "a build" }
	local keeps, busy = file.keeps(false)
	assert(keeps and busy[1] == "a build", "kept while a build runs")
	greed.option.set("on-quit", "end")
	assert(not file.keeps(false), "end ends it anyway")
	greed.option.set("on-quit-remote", "auto")
	assert(file.keeps(true), "auto over ssh keeps it while a build runs")
	running = {}
	assert(not file.keeps(true), "and ends it once nothing does")
	greed.option.set("on-quit", "keep")
	assert(file.keeps(false), "keep always keeps it")
	greed.option.set("on-quit", "auto")
	greed.option.set("on-quit-remote", "keep")
	file.running("test", function()
		return {}
	end)
end)

test("quit outside a session ends it even with on-quit keep", function(t)
	t:buffer("|abc")
	greed.option.set("on-quit", "keep")
	t:run("quit")
	assert(t:quitting(), "quit")
	greed.option.set("on-quit", "auto")
end)

test("a file's open buffer is found however its path is written", function(t)
	local core = require("@core")
	local dir = t:tempdir({ [".git/HEAD"] = "", ["src/a.rs"] = "a\n" })
	t:run("project", { dir })
	local buffer = greed.load(dir .. "/src/a.rs")
	for _, spelling in
		{ "src/a.rs", "./src//a.rs", dir .. "/src/a.rs", dir .. "/src/../src/./a.rs" }
	do
		local found = core.file.buffer(spelling)
		assert(found and found:id() == buffer:id(), spelling)
	end
	local found = greed.buffer_for(dir .. "/x/../src/a.rs")
	assert(found and found:id() == buffer:id(), "greed.buffer_for works out ..")
	assert(core.file.buffer("src/b.rs") == nil, "not open")
	assert(greed.buffer_for(dir .. "/src/b.rs") == nil, "and finding doesn't open it")
	local home = assert(greed.fs.dirs().home)
	local notes = greed.load(home .. "/notes.md")
	local by_home = greed.buffer_for("~/notes.md")
	assert(by_home and by_home:id() == notes:id(), "~ is the home folder")
	local resolved = core.file.buffer("~/notes.md")
	assert(resolved and resolved:id() == notes:id())
end)

test("a file's text is as you have it, unsaved changes included", function(t)
	local core = require("@core")
	local dir = t:tempdir({ [".git/HEAD"] = "", ["a.txt"] = "disk\n", ["b.txt"] = "b\n" })
	t:run("project", { dir })
	local buffer = greed.load(dir .. "/a.txt")
	buffer:edit(function(e)
		e:replace(0, 4, "unsaved")
	end)
	assert(core.file.text("a.txt") == "unsaved\n", "the buffer's text")
	assert(core.file.text(dir .. "/b.txt") == "b\n", "a closed file's from disk")
	local text, err = core.file.text("missing.txt")
	assert(text == nil and err, "nil and why for no file")
end)

test("writing a file goes through its buffer when it's open, and to disk when not", function(t)
	local core = require("@core")
	local dir = t:tempdir({ [".git/HEAD"] = "", ["a.txt"] = "one two\n", ["b.txt"] = "b\n" })
	t:run("project", { dir })
	greed.open(dir .. "/a.txt")
	local buffer = greed.view():buffer()
	local through = core.file.write("a.txt", "three", { from = 4, to = 7 })
	assert(through and through:id() == buffer:id(), "through the open buffer")
	assert(buffer:text() == "one three\n" and not buffer:modified(), "and saved")
	assert(greed.fs.read(dir .. "/a.txt") == "one three\n")
	greed.view():undo()
	assert(buffer:text() == "one two\n", "undo takes it back")

	assert(core.file.write("b.txt", "B", { from = 0, to = 1 }) == nil, "a closed file")
	assert(greed.fs.read(dir .. "/b.txt") == "B\n")
	assert(greed.buffer_for(dir .. "/b.txt") == nil, "isn't opened")
	local loaded = core.file.write("b.txt", "x\n", { load = true })
	assert(loaded and loaded:text() == "x\n", "unless asked to")
	assert(core.file.write("new/c.txt", "c\n", { load = true }) == nil, "a new file")
	assert(greed.fs.read(dir .. "/new/c.txt") == "c\n")
	assert(not pcall(core.file.write, "/nonexistent-dir/x/y.txt", "x", nil), "fails with why")
end)

-- Registers an opener for .view files that shows a buffer saying what it
-- opened, or fails for files holding "bad".
local function view_opener()
	local file = require("@core").file
	file.opener(function(path)
		return string.match(path, "%.view$") ~= nil
	end, function(path, views)
		if greed.fs.read(path) == "bad" then
			return "can't show " .. path
		end
		local shown = greed.create_buffer("viewer", "viewing " .. path)
		for _, view in views do
			view:show(shown)
		end
		return nil
	end)
end

test("an opener shows its files directly, and takes over ones opened as text", function(t)
	view_opener()
	local dir = t:tempdir({ ["a.view"] = "bytes", ["b.view"] = "bytes" })
	t:buffer("|")
	require("@core").file.open(dir .. "/a.view")
	assert(greed.view():buffer():kind() == "viewer", greed.view():buffer():kind())
	assert(greed.buffer_for(dir .. "/a.view") == nil, "no text buffer for it")
	greed.open(dir .. "/b.view")
	assert(greed.view():buffer():text() == "viewing " .. dir .. "/b.view")
end)

test("a file its opener can't show opens as text, saying why once", function(t)
	view_opener()
	local dir = t:tempdir({ ["c.view"] = "bad" })
	t:buffer("|")
	require("@core").file.open(dir .. "/c.view")
	assert(greed.view():buffer():text() == "bad")
	local said = 0
	for _, message in t:messages() do
		if string.find(message, "can't show", 1, true) then
			said += 1
		end
	end
	assert(said == 1, `said it {said} times`)
end)

test("open_at puts the cursor on a line and column, kept inside the file", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\ntwo\nthree" })
	local file = require("@core").file
	file.open_at(dir .. "/a.txt", 1, 2)
	t:expect("one\ntw|o\nthree")
	file.open_at(dir .. "/a.txt", 9, 9)
	t:expect("one\ntwo\nthree|")
	file.open_at(dir .. "/a.txt", 0)
