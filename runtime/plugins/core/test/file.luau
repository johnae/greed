local test = require("@greed/test")
local greed = require("@greed")
local core = require("@core")

test("quit refuses while there are unsaved changes", function(t)
	t:buffer("|abc")
	t:keys("i x esc")
	local ok, err = pcall(function()
		t:run("quit")
	end)
	assert(not ok, "quit should refuse")
	assert(string.find(tostring(err), "unsaved changes", 1, true), tostring(err))
	assert(not t:quitting(), "still running")

	greed.run("quit", { force = true })
	assert(t:quitting(), "force quits anyway")
end)

test("quit goes ahead when nothing changed", function(t)
	t:buffer("|abc")
	t:run("quit")
	assert(t:quitting(), "quit")
end)

test("open needs a path", function(t)
	t:buffer("|abc")
	local ok, err = pcall(function()
		t:run("open")
	end)
	assert(not ok and string.find(tostring(err), "path", 1, true), tostring(err))
end)

test(":w writes the file, and :w PATH makes PATH the buffer's file", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one" })
	greed.open(dir .. "/a.txt")
	t:keys("g l a ! esc")
	t:run("save")
	assert(greed.fs.read(dir .. "/a.txt") == "one!", (greed.fs.read(dir .. "/a.txt")))
	assert(not greed.view():buffer():modified(), "saved")
	local messages = t:messages()
	assert(string.find(messages[#messages], "wrote", 1, true), messages[#messages])

	t:run("save", { dir .. "/b.txt" })
	assert(greed.fs.read(dir .. "/b.txt") == "one!")
	assert(greed.view():buffer():path() == dir .. "/b.txt", greed.view():buffer():path())
end)

test(":w into a folder that isn't there refuses, and :w! makes it", function(t)
	local dir = t:tempdir()
	greed.open(dir .. "/sub/deeper/a.txt")
	t:keys("i x esc")
	local ok, err = pcall(function()
		t:run("save")
	end)
	assert(not ok and string.find(tostring(err), ":w!", 1, true), tostring(err))
	assert(greed.fs.stat(dir .. "/sub") == nil, "no folder made")
	assert(greed.view():buffer():modified(), "not saved")

	greed.run("save", { force = true })
	assert(greed.fs.read(dir .. "/sub/deeper/a.txt") == "x", "made and saved")

	greed.run("save", { args = { dir .. "/other/b.txt" }, force = true })
	assert(greed.fs.read(dir .. "/other/b.txt") == "x", "with a path too")

	greed.open(dir .. "/more/c.txt")
	t:keys("i c esc")
	ok, err = pcall(function()
		t:run("save-all")
	end)
	assert(not ok and string.find(tostring(err), ":wa!", 1, true), tostring(err))
	greed.run("save-all", { force = true })
	assert(greed.fs.read(dir .. "/more/c.txt") == "c", "save-all forced makes it")
end)

test("ctrl-s saves from any mode", function(t)
	local dir = t:tempdir({ ["a.txt"] = "x" })
	greed.open(dir .. "/a.txt")
	t:keys("i y ctrl-s")
