test(":file-rename moves the file and its buffer; :file-delete asks for y first", function(t)
	local dir = t:tempdir({ ["old.txt"] = "kept\n" })
	greed.open(`{dir}/old.txt`)
	t:run("file-rename", { "new.txt" })
	assert(
		greed.fs.read(`{dir}/new.txt`) == "kept\n" and greed.fs.stat(`{dir}/old.txt`) == nil,
		"moved"
	)
	assert(greed.view():buffer():path() == `{dir}/new.txt`, "the buffer went along")
	greed.view():buffer():edit(function(e)
		e:insert(0, "x")
	end)
	local ok, err = pcall(function()
		t:run("file-rename", { "other.txt" })
	end)
	assert(not ok and string.find(tostring(err), "unsaved changes", 1, true), tostring(err))
	t:run("save")
	t:keys(": f i l e - d e l e t e enter n")
	assert(greed.fs.stat(`{dir}/new.txt`), "kept without y")
	t:keys(": f i l e - d e l e t e enter y")
	assert(greed.fs.stat(`{dir}/new.txt`) == nil, "deleted with y")
end)
