local test = require("@greed/test")
local greed = require("@greed")

test("quit refuses while there are unsaved changes", function(t)
	t:buffer("|abc")
	t:keys("i x esc")
	local ok, err = pcall(function()
		t:run("quit")
	end)
	assert(not ok, "quit should refuse")
	assert(string.find(tostring(err), "unsaved changes", 1, true), tostring(err))
	assert(not t:quitting(), "still running")

	greed.run("quit", { force = true })
	assert(t:quitting(), "force quits anyway")
end)

test("quit goes ahead when nothing changed", function(t)
	t:buffer("|abc")
	t:run("quit")
	assert(t:quitting(), "quit")
end)

test("open needs a path", function(t)
	t:buffer("|abc")
	local ok, err = pcall(function()
		t:run("open")
	end)
	assert(not ok and string.find(tostring(err), "path", 1, true), tostring(err))
end)

test(":w writes the file, and :w PATH makes PATH the buffer's file", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one" })
	greed.open(dir .. "/a.txt")
	t:keys("g l a ! esc")
	t:run("save")
	assert(greed.fs.read(dir .. "/a.txt") == "one!", (greed.fs.read(dir .. "/a.txt")))
	assert(not greed.view():buffer():modified(), "saved")
	local messages = t:messages()
	assert(string.find(messages[#messages], "wrote", 1, true), messages[#messages])

	t:run("save", { dir .. "/b.txt" })
	assert(greed.fs.read(dir .. "/b.txt") == "one!")
	assert(greed.view():buffer():path() == dir .. "/b.txt", greed.view():buffer():path())
end)

test("ctrl-s saves from any mode", function(t)
	local dir = t:tempdir({ ["a.txt"] = "x" })
	greed.open(dir .. "/a.txt")
	t:keys("i y ctrl-s")
	assert(greed.fs.read(dir .. "/a.txt") == "yx", (greed.fs.read(dir .. "/a.txt")))
end)

test("a buffer without a file can't be saved without a path", function(t)
	t:buffer("|abc")
	assert(not pcall(function()
		t:run("save")
	end))
end)

test("buffers of a kind with a saver save through it", function(t)
	local saved = nil
	require("@core").file.on_save("notes", function(buffer)
		saved = buffer:text()
	end)
	local buffer = greed.create_buffer("notes", "hello")
	greed.view():show(buffer)
	t:run("save")
	assert(saved == "hello", tostring(saved))
end)

test(":qa refuses with unsaved changes in any project, and force quits anyway", function(t)
	local first = t:tempdir({ [".git/HEAD"] = "", ["a.txt"] = "a" })
	local second = t:tempdir({ [".git/HEAD"] = "", ["b.txt"] = "b" })
	greed.run("project", { args = { first } })
	greed.open(first .. "/a.txt")
	t:keys("i x esc")
	greed.run("project", { args = { second } })
	local ok, err = pcall(function()
		t:run("quit-all")
	end)
	assert(not ok and string.find(tostring(err), "a.txt", 1, true), tostring(err))
	assert(not t:quitting())
	greed.run("quit-all", { force = true })
	assert(t:quitting(), "force quits")
end)

test(":wq saves, then quits", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a" })
	greed.open(dir .. "/a.txt")
	t:keys("i z esc")
	t:run("save-quit")
	assert(greed.fs.read(dir .. "/a.txt") == "za")
	assert(t:quitting())
end)

test(":detach lets the client go and keeps running", function(t)
	t:buffer("|abc")
	t:run("detach")
	assert(t:detached(), "detached")
	assert(not t:quitting(), "still running")
	assert(not t:detached(), "only once")
end)

-- Whether a buffer for `path` is open.
local function is_open(path: string): boolean
	for _, buffer in greed.buffers() do
		if buffer:path() == path then
			return true
		end
	end
	return false
end

test(":bc closes the buffer and shows the file opened before it", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a", ["b.txt"] = "b", ["c.txt"] = "c" })
	greed.open(dir .. "/a.txt")
	greed.open(dir .. "/b.txt")
	greed.open(dir .. "/c.txt")
	t:run("buffer-close")
	assert(not is_open(dir .. "/c.txt"), "c is closed")
	assert(greed.view():buffer():path() == dir .. "/b.txt", greed.view():buffer():path())

	-- With no other file left, an empty buffer takes its place.
	t:run("buffer-close")
	t:run("buffer-close")
	assert(greed.view():buffer():path() == nil and greed.view():buffer():text() == "")
	assert(not is_open(dir .. "/a.txt"))
end)

test(":bc refuses with unsaved changes, and :bc! closes anyway", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a" })
	greed.open(dir .. "/a.txt")
	t:keys("i x esc")
	local ok, err = pcall(function()
		t:run("buffer-close")
	end)
	assert(not ok and string.find(tostring(err), "unsaved changes", 1, true), tostring(err))
	assert(is_open(dir .. "/a.txt"), "still open")
	greed.run("buffer-close", { force = true })
	assert(not is_open(dir .. "/a.txt"), "forced")
	assert(greed.fs.read(dir .. "/a.txt") == "a", "and the file is as it was")
end)

test(":bco closes every other file", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a", ["b.txt"] = "b", ["c.txt"] = "c" })
	greed.open(dir .. "/a.txt")
	greed.open(dir .. "/b.txt")
	greed.open(dir .. "/c.txt")
	t:run("buffer-close-others")
	assert(is_open(dir .. "/c.txt"))
	assert(not is_open(dir .. "/a.txt") and not is_open(dir .. "/b.txt"))
end)

test("a buffer a view shows can't close until something else is shown", function(t)
	t:buffer("|abc")
	local buffer = greed.view():buffer()
	local closed: number? = nil
	greed.on("buffer.closed", function(event)
		closed = event.id
	end)
	assert(not pcall(buffer.close, buffer), "shown")
	local id = buffer:id()
	-- Without a file it would go by itself once nothing shows it.
	buffer:set_kept(true)
	greed.view():show(greed.create_buffer("file", "other"))
	buffer:close()
	assert(closed == id, "plugins hear about it")
end)

test("quit in a panel or a float closes just that", function(t)
	t:buffer("|abc")
	local main = greed.view()
	local panel = greed.panel(greed.create_buffer("notes", "a panel"), { side = "right" })
	panel:focus()
	t:run("quit")
	assert(not t:quitting(), "the editor goes on")
	assert(greed.view():id() == main:id(), "back in the file")
	greed.float(greed.create_buffer("notes", "a float"), {}):focus()
	t:run("quit")
	assert(not t:quitting() and greed.view():id() == main:id(), "the float closed")
end)

test("open and save take ~ as the home folder", function(t)
	t:buffer("|")
	local home = assert(greed.fs.dirs().home)
	greed.fs.write(`{home}/notes.md`, "my notes\n")
	t:run("open", { "~/notes.md" })
	local buffer = greed.view():buffer()
	assert(buffer:path() == `{home}/notes.md`, tostring(buffer:path()))
	assert(buffer:text() == "my notes\n", buffer:text())
	t:run("save", { "~/copy.md" })
	assert(greed.fs.read(`{home}/copy.md`) == "my notes\n", "saved there")
end)

test("on-quit keeps the session while something runs, and as told", function()
	local file = require("@core").file
	local running = {}
	file.running("test", function()
		return running
	end)
	assert(not file.keeps(false), "nothing runs: auto ends it")
	assert(file.keeps(true), "over ssh it's kept by default")
	running = { "a build" }
	local keeps, busy = file.keeps(false)
	assert(keeps and busy[1] == "a build", "kept while a build runs")
	greed.option.set("on-quit", "end")
	assert(not file.keeps(false), "end ends it anyway")
	greed.option.set("on-quit-remote", "auto")
	assert(file.keeps(true), "auto over ssh keeps it while a build runs")
	running = {}
	assert(not file.keeps(true), "and ends it once nothing does")
	greed.option.set("on-quit", "keep")
	assert(file.keeps(false), "keep always keeps it")
	greed.option.set("on-quit", "auto")
	greed.option.set("on-quit-remote", "keep")
	file.running("test", function()
		return {}
	end)
end)

test("quit outside a session ends it even with on-quit keep", function(t)
	t:buffer("|abc")
	greed.option.set("on-quit", "keep")
	t:run("quit")
	assert(t:quitting(), "quit")
	greed.option.set("on-quit", "auto")
end)
