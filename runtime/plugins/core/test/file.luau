local files = require("@core").file

-- Waits on the file `path` opens as in a spawned task, as a program run
-- through `greed edit --wait` does; the outcome comes in the table.
local function waiting_on(path: string): { outcome: string? }
	greed.open(path)
	local buffer = greed.view():buffer()
	local got: { outcome: string? } = {}
	greed.spawn(function()
		got.outcome = files.wait(buffer)
	end)
	return got
end

test(":q in a file a program waits on ends the wait, and doesn't quit", function(t)
	local dir = t:tempdir({ ["msg"] = "fix" })
	local got = waiting_on(dir .. "/msg")
	assert(files.waited(greed.view():buffer()))
	t:run("quit")
	t:wait_for(function()
		return got.outcome ~= nil
	end)
	assert(got.outcome == "done", tostring(got.outcome))
	assert(not t:quitting(), "still running")
	assert(not files.waited(greed.view():buffer()))
end)

test(":q refuses over unsaved changes in it, :wq saves and ends the wait", function(t)
	local dir = t:tempdir({ ["msg"] = "fix" })
	local got = waiting_on(dir .. "/msg")
	t:keys("g l a ! esc")
	local ok, err = pcall(function()
		t:run("quit")
	end)
	assert(not ok and string.find(tostring(err), "unsaved changes", 1, true), tostring(err))
	assert(got.outcome == nil, "still waiting")
	t:run("save-quit")
	t:wait_for(function()
		return got.outcome ~= nil
	end)
	assert(got.outcome == "done" and greed.fs.read(dir .. "/msg") == "fix!")
	assert(not t:quitting(), "still running")
end)

test(":cq stops the program; elsewhere it says nothing waits", function(t)
	local dir = t:tempdir({ ["msg"] = "fix" })
	local got = waiting_on(dir .. "/msg")
	t:run("quit-abort")
	t:wait_for(function()
		return got.outcome ~= nil
	end)
	assert(got.outcome == "aborted", tostring(got.outcome))
	local ok, err = pcall(function()
		t:run("quit-abort")
	end)
	assert(not ok and string.find(tostring(err), "no program waits", 1, true), tostring(err))
end)

test("closing a file a program waits on ends the wait", function(t)
	local dir = t:tempdir({ ["msg"] = "fix" })
	local got = waiting_on(dir .. "/msg")
	files.close(greed.view():buffer())
	t:wait_for(function()
		return got.outcome ~= nil
	end)
	assert(got.outcome == "done", tostring(got.outcome))
end)

test("open_link opens only web and mail links outside; a file link opens here", function(t)
	t:buffer("|x")
	local dir = t:tempdir({ ["a b.txt"] = "here\n" })
	greed.fs.write(dir .. "/open.sh", `echo "$1" > {dir}/opened`)
	greed.option.set("link-opener", `sh {dir}/open.sh`)
	require("@core").file.open_link("javascript:alert(1)")
	require("@core").file.open_link("vscode://x")
	assert(greed.fs.read(dir .. "/opened") == nil, "neither went to the opener")
	assert(
		string.find(table.concat(t:messages(), "\n"), "only http, https and mailto", 1, true) ~= nil
	)
	require("@core").file.open_link(`file://{dir}/a%20b.txt`)
	assert(greed.view():buffer():path() == `{dir}/a b.txt`, tostring(greed.view():buffer():path()))
	greed.option.set("link-opener", "")
end)

test("a plugin's link scheme opens its links in Greed", function(t)
	t:buffer("|x")
	local opened = {}
	core.file.link_scheme("Thing", function(uri)
		table.insert(opened, uri)
	end)
	core.file.open_link("thing:42")
	core.file.open_link("THING:43")
	assert(table.concat(opened, " ") == "thing:42 THING:43", table.concat(opened, " "))
	assert(#t:messages() == 0, t:messages()[1])
end)

test(":bd on an untitled buffer closes it quietly, and :q's hint fits what's unsaved", function(t)
