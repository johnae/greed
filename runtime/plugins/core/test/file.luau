test(
	":e! loads the file again, :e on a folder says how to find a file, :w !cmd says what to use",
	function(t)
		local dir = t:tempdir({ ["a.txt"] = "disk\n" })
		greed.open(`{dir}/a.txt`)
		greed.view():buffer():edit(function(e)
			e:insert(0, "typed ")
		end)
		greed.run("open", { force = true, wait = true })
		assert(greed.view():buffer():text() == "disk\n", greed.view():buffer():text())
		local ok, err = pcall(function()
			t:run("open", { dir })
		end)
		assert(not ok and string.find(tostring(err), "is a folder", 1, true), tostring(err))
		ok, err = pcall(function()
			t:run("save", { "!cat" })
		end)
		assert(not ok and string.find(tostring(err), ":%!cmd", 1, true), tostring(err))
		assert(greed.fs.stat(`{dir}/!cat`) == nil, "no file called !cat")
	end
)

