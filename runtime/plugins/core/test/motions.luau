-- Buffers are written with markers: `|` is a selection's head and `^` its
-- anchor (left out for cursors). "^hello |world" selects "hello ". In
-- normal mode the cursor is a block on a character, as in Helix: on the
-- one after a lone `|`, and on a selection's last character going forward.

local test = require("@greed/test")

local function check(t: test.TestContext, before: string, keys: string, after: string)
	t:buffer(before)
	t:keys(keys)
	t:expect(after)
end

test("character moves stay on the line", function(t)
	check(t, "a|bc\ndef", "l l l", "abc|\ndef")
	check(t, "abc\nd|ef", "h h h", "abc\n|def")
end)

test("line moves keep the column", function(t)
	check(t, "ab|cd\nx\nwxyz", "j", "abcd\nx|\nwxyz")
	check(t, "ab|cd\nx\nwxyz", "j j", "abcd\nx\nwx|yz")
	check(t, "abcd\nwx|yz", "k", "ab|cd\nwxyz")
	check(t, "ab|cd", "k", "ab|cd")
	check(t, "é|é\néé", "j", "éé\né|é")
end)

test("word motions select what they move over", function(t)
	check(t, "|hello world", "w", "^hello |world")
	check(t, "|hello world", "w w", "hello ^world|")
	check(t, "|foo.bar", "w", "^foo|.bar")
	check(t, "|héllo wörld", "w", "^héllo |wörld")
	-- The character under the cursor is part of what it moves over.
	check(t, "hello wor|ld", "b", "hello |worl^d")
	check(t, "hello |world", "b", "|hello ^world")
	check(t, "|hello world", "e", "^hello| world")
	check(t, "hello| world", "e", "hello^ world|")
end)

test("line and buffer jumps", function(t)
	-- g l lands on the line's last character.
	check(t, "a|bc\ndef", "g l", "ab|c\ndef")
	check(t, "ab|c\ndef", "g h", "|abc\ndef")
	check(t, "abc\nde|f", "g g", "|abc\ndef")
	check(t, "a|bc\ndef", "g e", "abc\n|def")
	check(t, "a|bc\ndef\n", "g e", "abc\n|def\n")
end)

test("select line includes the line break", function(t)
	check(t, "a|bc\ndef", "x", "^abc\n|def")
	check(t, "abc\nd|ef", "x", "abc\n^def|")
end)

test("collapse and flip", function(t)
	-- ; keeps the cursor on the character it was on.
	check(t, "^hello |world", ";", "hello| world")
	check(t, "|a,b", "f , ; d", "a|b")
	check(t, "^hello |world", "alt-;", "|hello ^world")
end)

test("extend moves keep the anchor", function(t)
	-- Both ends stay on whole characters, the cursor's included.
	t:buffer("ab|cd\nef")
	t:run("extend-right")
	t:expect("ab^cd|\nef")
	t:run("extend-down")
	t:expect("ab^cd\nef|")
	t:run("extend-line-start")
	t:expect("ab^cd\ne|f")
	t:run("extend-start")
	t:expect("|abc^d\nef")
end)

test("word moves and select all", function(t)
	t:buffer("|one two three")
	t:run("move-word-right")
	t:expect("one |two three")
	t:run("extend-word-right")
	t:expect("one ^two |three")
	t:run("move-word-left")
	t:expect("one |two three")
	t:run("select-all")
	t:expect("^one two three|")
end)

test("x again takes the next line too, and copes with the last line", function(t)
	t:buffer("o|ne\ntwo\nthree")
	t:keys("x x")
	t:expect("^one\ntwo\n|three")
	t:buffer("one\nt|wo")
	t:keys("x")
	t:expect("one\n^two|")
	t:buffer("o^ne\ntw|o\nthree")
	t:keys("x")
	t:expect("^one\ntwo\n|three")
end)

test("counts repeat a motion", function(t)
	check(t, "|a\nb\nc\nd\ne", "3 j", "a\nb\nc\n|d\ne")
	check(t, "|one two three four", "2 w", "one ^two |three four")
	check(t, "a\nb\nc\nd|", "2 k", "a\nb|\nc\nd")
end)

test("G goes to a line by number, or the last one", function(t)
	check(t, "|a\nb\nc\nd", "G", "a\nb\nc\n|d")
	check(t, "a\nb\nc\n|d", "2 G", "a\n|b\nc\nd")
	check(t, "a\nb\nc\n|d", "3 g g", "a\nb\n|c\nd")
end)

test("f and t select to a character, F and T backwards, as in Helix", function(t)
	check(t, "|a,b,c", "f ,", "^a,|b,c")
	-- t skips the character right after the cursor, so pressing it again moves on.
	check(t, "|a,b,c", "t ,", "^a,b|,c")
	check(t, "|ab,c", "t ,", "^ab|,c")
	check(t, "|a,b,c", "2 f ,", "^a,b,|c")
	check(t, "a,b,|c", "F ,", "a,b|,c^")
	check(t, "a,b,c|", "T ,", "a,b,|c^")
	check(t, "|abc\nx,y", "f ,", "^abc\nx,|y")
	check(t, "|abc", "f ,", "|abc")
end)

test("W, B and E move by WORDs, which include punctuation", function(t)
	check(t, "|a.b c.d", "W", "^a.b |c.d")
	check(t, "a.b c.d|", "B", "a.b |c.d^")
	check(t, "|a.b c.d", "E", "^a.b| c.d")
end)

test("g s goes to the first character that isn't a space, m m to the matching bracket", function(t)
	check(t, "  ab|c", "g s", "  |abc")
	check(t, "|f(a, (b))", "l m m", "f(a, (b)|)")
	check(t, "f(a, (b)|)", "m m", "f|(a, (b))")
	check(t, "f(a, [|b])", "m m", "f(a, [b|])")
end)

test("j and k step over folded lines", function(t)
	local greed = require("@greed")
	t:buffer("|# A\none\ntwo\n# B")
	local buffer = greed.view():buffer()
	buffer:decorate("fold", { { from = 0, to = 11, style = "fold", fold = true } })
	assert(#greed.view():hidden_lines() == 1, "lines 1 and 2 are folded")
	t:keys("j")
	t:expect("# A\none\ntwo\n|# B")
	t:keys("k")
	t:expect("|# A\none\ntwo\n# B")
	buffer:decorate("fold", {})
	t:keys("j")
	t:expect("# A\n|one\ntwo\n# B")
end)
