local test = require("@greed/test")
local greed = require("@greed")

local function lines(n: number): string
	local out = {}
	for i = 0, n - 1 do
		table.insert(out, `line {i}`)
	end
	return table.concat(out, "\n")
end

test("z t, z b and z c put the cursor's line at the top, bottom or middle", function(t)
	t:buffer(lines(20) .. "\n|" .. lines(30))
	t:draw(40, 11)
	t:keys("z t")
	assert(greed.view():scroll() == 20, tostring(greed.view():scroll()))
	t:draw(40, 11)
	t:keys("z b")
	assert(greed.view():scroll() == 11, tostring(greed.view():scroll()))
	t:draw(40, 11)
	t:keys("z c")
	assert(greed.view():scroll() == 15, tostring(greed.view():scroll()))
end)

test("z j and z k scroll the view, Z keeps the view keys until esc", function(t)
	t:buffer(lines(5) .. "\n|" .. lines(45))
	t:draw(40, 11)
	t:keys("z j z j")
	assert(greed.view():scroll() == 2, tostring(greed.view():scroll()))
	t:keys("Z j j k")
	t:expect_mode("view")
	assert(greed.view():scroll() == 3, tostring(greed.view():scroll()))
	t:keys("esc")
	t:expect_mode("helix")
end)

test(
	"g t and g b go to the top and bottom line on the screen, out of the scroll margin",
	function(t)
		greed.option.set("scroll-margin", 2)
		t:buffer("|" .. lines(50))
		t:draw(40, 11)
		local buffer = greed.view():buffer()
		local function line(): number
			return buffer:line_of(greed.view():selection().ranges[1].head)
		end
		t:keys("g b")
		assert(line() == 7, "the margin's lines below: " .. line())
		t:keys("g t")
		assert(line() == 0, "none above the buffer's first line: " .. line())
		local at = buffer:line_start(30)
		greed.view():set_selection({ ranges = { { anchor = at, head = at } }, primary = 1 })
		t:draw(40, 11)
		local top = greed.view():scroll()
		t:keys("g t")
		assert(line() == top + 2, `the margin's lines above: {line()} under {top}`)
		assert(greed.view():scroll() == top, "the view stays")
	end
)

test("g n, g p and g a go between open files, g m to the last one changed", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a", ["b.txt"] = "b" })
	greed.open(dir .. "/a.txt")
	t:keys("i x esc")
	greed.open(dir .. "/b.txt")
	t:keys("g a")
	assert(greed.view():buffer():path() == dir .. "/a.txt", "back to a")
	t:keys("g a")
	assert(greed.view():buffer():path() == dir .. "/b.txt", "and to b")
	t:keys("g m")
	assert(greed.view():buffer():path() == dir .. "/a.txt", "a was changed")
	local before = greed.view():buffer():id()
	t:keys("g n")
	assert(greed.view():buffer():id() ~= before, "g n shows another file")
	t:keys("g p")
	assert(greed.view():buffer():id() == before, "g p comes back")
end)

test("g a knows files a plugin showed, with no keys in between", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a", ["b.txt"] = "b", ["c.txt"] = "c" })
	greed.open(dir .. "/a.txt")
	t:wait(0)
	greed.open(dir .. "/b.txt")
	t:wait(0)
	greed.open(dir .. "/c.txt")
	t:keys("g a")
	assert(greed.view():buffer():path() == dir .. "/b.txt", greed.view():buffer():path())
end)

test("g . goes to the last change, g | to a column", function(t)
	t:buffer("|one\ntwo\nthree")
	t:keys("j i X esc g g g .")
	t:expect("one\nX|two\nthree")
	t:keys("3 g |")
	t:expect("one\nXt|wo\nthree")
end)

test("g f opens the file named under the cursor", function(t)
	local dir = t:tempdir({ ["a.txt"] = "see b.txt here", ["b.txt"] = "bee" })
	greed.open(dir .. "/a.txt")
	t:keys("w w g f")
	assert(greed.view():buffer():path() == dir .. "/b.txt", tostring(greed.view():buffer():path()))
end)

test("alt-. does the last f or t again", function(t)
	t:buffer("|a,b,c")
	t:keys("f , alt-.")
	t:expect("a^,b,|c")
end)
