local test = require("@greed/test")
local greed = require("@greed")

test("ctrl-o goes back to where a jump started, ctrl-i forward again", function(t)
	t:buffer("|one\ntwo\nthree\nfour")
	t:keys("j l G")
	t:expect("one\ntwo\nthree\n|four")
	t:keys("g g")
	t:keys("ctrl-o")
	t:expect("one\ntwo\nthree\n|four")
	t:keys("ctrl-o")
	t:expect("one\nt|wo\nthree\nfour")
	t:keys("ctrl-o")
	t:expect("one\nt|wo\nthree\nfour")
	t:keys("ctrl-i")
	t:expect("one\ntwo\nthree\n|four")
end)

test("jumps between files come back to the file", function(t)
	local dir = t:tempdir({ ["a.txt"] = "aaa", ["b.txt"] = "bbb" })
	greed.open(dir .. "/a.txt")
	t:keys("l")
	t:run("open", { dir .. "/b.txt" })
	t:keys("ctrl-o")
	assert(greed.view():buffer():path() == dir .. "/a.txt", greed.view():buffer():path())
	t:expect("a|aa")
	t:keys("ctrl-i")
	assert(greed.view():buffer():path() == dir .. "/b.txt")
end)
