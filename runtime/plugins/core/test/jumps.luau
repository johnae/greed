local test = require("@greed/test")
local greed = require("@greed")

test("ctrl-o goes back to where a jump started, ctrl-i forward again", function(t)
	t:buffer("|one\ntwo\nthree\nfour")
	t:keys("j l G")
	t:expect("one\ntwo\nthree\n|four")
	t:keys("g g")
	t:keys("ctrl-o")
	t:expect("one\ntwo\nthree\n|four")
	t:keys("ctrl-o")
	t:expect("one\nt|wo\nthree\nfour")
	t:keys("ctrl-o")
	t:expect("one\nt|wo\nthree\nfour")
	t:keys("ctrl-i")
	t:expect("one\ntwo\nthree\n|four")
end)

test("jumps between files come back to the file", function(t)
	local dir = t:tempdir({ ["a.txt"] = "aaa", ["b.txt"] = "bbb" })
	greed.open(dir .. "/a.txt")
	t:keys("l")
	t:run("open", { dir .. "/b.txt" })
	t:keys("ctrl-o")
	assert(greed.view():buffer():path() == dir .. "/a.txt", greed.view():buffer():path())
	t:expect("a|aa")
	t:keys("ctrl-i")
	assert(greed.view():buffer():path() == dir .. "/b.txt")
end)

test("a view showing another buffer is a jump, whatever showed it", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\ntwo\nthree", ["b.txt"] = "bbb", ["c.txt"] = "ccc" })
	greed.open(dir .. "/a.txt")
	t:keys("j")
	greed.open(dir .. "/b.txt")
	t:keys("l")
	greed.open(dir .. "/c.txt")
	t:keys("ctrl-o")
	assert(greed.view():buffer():path() == dir .. "/b.txt", "back to b")
	t:expect("b|bb")
	t:keys("ctrl-o")
	assert(greed.view():buffer():path() == dir .. "/a.txt", "back to a")
	t:expect("one\n|two\nthree")
	t:keys("ctrl-i ctrl-i")
	assert(greed.view():buffer():path() == dir .. "/c.txt", "forward to c")
end)

test("each view has its own jumps", function(t)
	local dir = t:tempdir({ ["a.txt"] = "aaa", ["b.txt"] = "bbb", ["c.txt"] = "ccc" })
	greed.open(dir .. "/a.txt")
	t:run("open", { dir .. "/b.txt" })
	greed.view():split("right"):focus()
	t:run("open", { dir .. "/c.txt" })
	t:keys("ctrl-o")
	assert(greed.view():buffer():path() == dir .. "/b.txt", greed.view():buffer():path())
	t:keys("ctrl-o")
	assert(greed.view():buffer():path() == dir .. "/b.txt", "nothing further back in this view")
end)

test("going back keeps where the view was scrolled", function(t)
	local lines = {}
	for i = 1, 200 do
		table.insert(lines, `line {i}`)
	end
	local dir = t:tempdir({ ["long.txt"] = table.concat(lines, "\n"), ["b.txt"] = "bbb" })
	greed.open(dir .. "/long.txt")
	local buffer = greed.view():buffer()
	greed.view():set_cursor(buffer:line_start(100))
	greed.view():set_scroll(95)
	t:keys("l h")
	t:run("open", { dir .. "/b.txt" })
	t:keys("ctrl-o")
	assert(greed.view():scroll() == 95, tostring(greed.view():scroll()))
end)
