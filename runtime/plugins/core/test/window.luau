local test = require("@greed/test")
local greed = require("@greed")

local function size(): number
	return greed.option.get("gui-font-size") :: number
end

test("ctrl-= and ctrl-- make the window's text bigger and smaller, ctrl-0 puts it back", function(t)
	t:buffer("|hello")
	t:keys("ctrl-=")
	assert(size() == 16, `bigger: {size()}`)
	t:keys("ctrl-+")
	assert(size() == 17, "ctrl-+ too, where + takes shift")
	t:keys("ctrl-- ctrl-- ctrl--")
	assert(size() == 14, `smaller: {size()}`)
	t:keys("ctrl-0")
	assert(size() == 15, `the size it starts at: {size()}`)
	t:keys("i ctrl-= esc")
	assert(size() == 16, "in any mode")
	t:expect("|hello")
end)

test("the size stays between 6 and 72", function(t)
	t:buffer("|")
	greed.option.set("gui-font-size", 72)
	t:keys("ctrl-=")
	assert(size() == 72, `{size()}`)
	greed.option.set("gui-font-size", 6)
	t:keys("ctrl--")
	assert(size() == 6, `{size()}`)
end)

test("ctrl-0 goes back to the size set before zooming, not the default", function(t)
	t:buffer("|")
	greed.option.set("gui-font-size", 13)
	t:keys("ctrl-= ctrl-=")
	assert(size() == 15)
	t:keys("ctrl-0")
	assert(size() == 13, `{size()}`)
end)

test("each window zooms on its own, and setting the size sets it for all", function(t)
	t:buffer("|hello")
	local second = t:client()
	local sizes: { [number]: number } = {}
	greed.command({
		name = "test-size",
		run = function(ctx)
			sizes[ctx.client] = size()
		end,
	})
	second:keys("ctrl-= ctrl-=")
	t:run("test-size")
	second:run("test-size")
	assert(sizes[1] == 15 and sizes[second:id()] == 17, `{sizes[1]} and {sizes[second:id()]}`)
	t:keys("ctrl--")
	second:run("test-size")
	assert(sizes[second:id()] == 17, "the first's zoom leaves the second's")
	greed.option.set("gui-font-size", 20)
	t:run("test-size")
	second:run("test-size")
	assert(sizes[1] == 20 and sizes[second:id()] == 20, "set for every window")
	second:keys("ctrl-= ctrl-0")
	second:run("test-size")
	assert(sizes[second:id()] == 20, `back to everyone's: {sizes[second:id()]}`)
end)
