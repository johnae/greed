    { "query": "tag!=garden is:todo", "ids": ["t3"] },
    { "query": "subject~eekl", "ids": ["m2"] },
    { "query": "size>10k is:mail", "ids": ["m1", "m2"] },
    { "query": "size:3k..20k", "ids": ["m1", "m3"] },
    { "query": "size>=1M", "ids": ["a1"] },
    { "query": "date:yesterday", "ids": ["m1"] },
    { "query": "date:2026-10", "ids": ["m1", "m2", "garden"] },
    { "query": "date:2w..", "ids": ["m1", "m2", "garden"] },
    { "query": "date:..2026-09-30", "ids": ["m3"] },
    { "query": "date<2026-10-01", "ids": ["m3"] },
    { "query": "date>=\"last week\"", "ids": ["m1", "garden"] },
    { "query": "date:\"last week\"", "ids": ["garden"] },
