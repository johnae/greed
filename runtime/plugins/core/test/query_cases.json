    { "query": "due:monday..", "ids": ["t3"] },
    { "query": "in:inbox is:unread", "ids": ["m1", "m3"] },
    { "query": "in:garden -is:done", "ids": ["t1", "t3"] },
    { "query": "in:(tag:garden) kitchen", "ids": ["t3"] },
    { "query": "under:inbox", "ids": ["m1", "a1", "m2", "m3"] },
    { "query": "in:inbox has:attachment", "ids": ["m1"] },
    { "query": "has:(is:todo -is:done due:..eow)", "ids": ["garden"] },
    { "query": "/^water/", "ids": ["t1"] },
    { "query": "subject:/^Weekly/", "ids": ["m2"] },
    { "query": "is:todo sort:due", "ids": ["t2", "t1", "t3"] },
    { "query": "is:mail sort:-date", "ids": ["m1", "m2", "m3"] },
    { "query": "is:mail sort:size limit:2", "ids": ["m3", "m1"] },
    { "query": "fom:anna", "problem": "did you mean from?" },
    { "query": "is:unred", "problem": "did you mean is:unread?" },
    { "query": "has:attachmnt", "problem": "did you mean has:attachment?" },
    { "query": "date:someday", "problem": "someday isn't a date" },
    { "query": "/(unclosed/", "problem": "a regex that doesn't work" },
    { "query": "sort:colour", "problem": "can't sort by colour" }
  ]
}
