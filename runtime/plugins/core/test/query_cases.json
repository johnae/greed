{
  "about": "What every engine running Greed's query language must agree on: the Luau one over items in memory and greed-index's over SQLite. Each case's query matches exactly `ids`, in that order when the query sorts, or has a problem whose message has `problem` in it. Today is `today`.",
  "today": "2026-10-14",
  "fields": {
    "from": { "kind": "text" },
    "subject": { "kind": "text" },
    "tag": { "kind": "exact" },
    "size": { "kind": "value" },
    "level": { "kind": "value" },
    "date": { "kind": "date" },
    "due": { "kind": "date", "ahead": true }
  },
  "flags": ["mail", "note", "todo", "unread", "done", "attachment"],
  "items": [
    { "id": "inbox", "name": "inbox", "text": "", "flags": [], "fields": {} },
    { "id": "m1", "parent": "inbox", "text": "Invoice 41 for October, please pay by Friday", "flags": ["mail", "unread"],
      "fields": { "from": "Anna Berg <anna@acme.example>", "subject": "Invoice due", "size": "12k", "date": "2026-10-13T09:00:00Z", "tag": ["work", "money"] } },
    { "id": "a1", "parent": "m1", "text": "invoice-41.pdf", "flags": ["attachment"], "fields": { "size": "2M" } },
    { "id": "m2", "parent": "inbox", "text": "This week's news: gardens, kitchens and C++ tips", "flags": ["mail"],
      "fields": { "from": "news@list.example", "subject": "Weekly news", "size": "40k", "date": "2026-10-01T09:00:00Z", "tag": ["news"] } },
    { "id": "m3", "parent": "inbox", "text": "Receipt for your order or else", "flags": ["mail", "unread"],
      "fields": { "from": "noreply@shop.example", "subject": "Your receipt", "size": "3k", "date": "2026-09-20T09:00:00Z", "level": "info" } },
    { "id": "garden", "name": "garden", "text": "Garden plans", "flags": ["note"], "fields": { "tag": ["garden"], "date": "2026-10-10" } },
    { "id": "t1", "parent": "garden", "text": "water the tomatoes", "flags": ["todo"], "fields": { "due": "2026-10-16", "tag": ["garden"] } },
    { "id": "t2", "parent": "garden", "text": "buy seeds", "flags": ["todo", "done"], "fields": { "due": "2026-10-12", "tag": ["garden"] } },
    { "id": "t3", "parent": "garden", "text": "plan the kitchen herbs", "flags": ["todo"], "fields": { "due": "2026-11-02", "tag": ["kitchen"] } }
  ],
  "cases": [
    { "query": "invoice", "ids": ["m1", "a1"] },
    { "query": "invo", "ids": [] },
    { "query": "invo*", "ids": ["m1", "a1"] },
    { "query": "INVOICE october", "ids": ["m1"] },
    { "query": "\"please pay\"", "ids": ["m1"] },
    { "query": "\"pay please\"", "ids": [] },
    { "query": "c++", "ids": ["m2"] },
    { "query": "or else", "ids": ["m3"] },
    { "query": "from:anna", "ids": ["m1"] },
    { "query": "from:acme", "ids": ["m1"] },
    { "query": "-from:noreply is:mail", "ids": ["m1", "m2"] },
    { "query": "is:unread", "ids": ["m1", "m3"] },
    { "query": "is:unr*", "ids": ["m1", "m3"] },
    { "query": "is:mail -is:unread", "ids": ["m2"] },
    { "query": "NOT is:mail is:todo", "ids": ["t1", "t2", "t3"] },
    { "query": "invoice OR receipt is:mail", "ids": ["m1", "m3"] },
    { "query": "(invoice receipt) OR news", "ids": ["m2"] },
    { "query": "tag:work", "ids": ["m1"] },
    { "query": "tag:WORK", "ids": ["m1"] },
    { "query": "tag:wor", "ids": [] },
    { "query": "tag:(garden OR kitchen) is:todo", "ids": ["t1", "t2", "t3"] },
