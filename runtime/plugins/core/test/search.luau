local test = require("@greed/test")
local greed = require("@greed")

test("/ selects the next match as you type, and enter keeps it", function(t)
	t:buffer("|one two one two")
	local buffer = greed.view():buffer()
	t:keys("/ t w")
	assert(#buffer:decorations("search") == 2, "every match is highlighted while typing")
	t:keys("o enter")
	t:expect("one ^two| one two")
	assert(#buffer:decorations("search") == 0, "the highlights go when the prompt does")
end)

test("n and N go to the next and previous match, round the ends", function(t)
	t:buffer("|one two one two")
	t:keys("/ t w o enter")
	t:keys("n")
	t:expect("one two one ^two|")
	t:keys("n")
	t:expect("one ^two| one two")
	t:keys("N")
	t:expect("one two one ^two|")
end)

test("? searches backwards", function(t)
	t:buffer("one two one two|")
	t:keys("? o n e enter")
	t:expect("one two ^one| two")
	t:keys("n")
	t:expect("^one| two one two")
end)

test("esc puts the selection back", function(t)
	t:buffer("o|ne two")
	t:keys("/ t w o")
	t:keys("esc")
	t:expect("o|ne two")
	t:expect_mode("helix")
end)

test("* searches for the selection, as plain text", function(t)
	t:buffer("^a.b| axb a.b")
	t:keys("* n")
	t:expect("a.b axb ^a.b|")
end)

test("lowercase patterns ignore case, ones with capitals don't", function(t)
	t:buffer("|x Two two")
	t:keys("/ t w o enter")
	t:expect("x ^Two| two")
	t:buffer("|x two Two")
	t:keys("/ T w o enter")
	t:expect("x two ^Two|")
end)

test("* with nothing selected keeps the last search", function(t)
	t:buffer("|one two one")
	t:keys("/ o n e enter")
	t:buffer("one two one|")
	t:keys("*")
	local messages = t:messages()
	assert(messages[#messages] == "nothing selected to search for", messages[#messages])
	t:buffer("|one two one")
	t:keys("n")
	t:expect("one two ^one|")
end)

test("* matches the selected text's case exactly", function(t)
	t:buffer("^one| One one")
	t:keys("* n")
	t:expect("one One ^one|")
end)

test("a search with no match, or a broken regex, says so", function(t)
	t:buffer("|abc")
	t:keys("/ z z z enter")
	local messages = t:messages()
	assert(messages[#messages] == "no match for zzz", messages[#messages])
	t:expect("|abc")
	t:buffer("|f(x) foo")
	t:keys("/ f ( enter")
	t:expect("|f(x) foo")
	t:expect_mode("helix")
	messages = t:messages()
	assert(string.find(messages[#messages], "f(", 1, true), messages[#messages])
end)

test("* matches whole words where the selection is one; alt-* anywhere", function(t)
	t:buffer("^foo| foobar foo")
	t:keys("* n")
	t:expect("foo foobar ^foo|")
	t:buffer("^foo| foobar foo")
	t:keys("alt-* n")
	t:expect("foo ^foo|bar foo")
end)

test("search-case says how every typed search minds case, fuzzy ones too", function(t)
	local search = require("@core").search
	assert(search.case() == "smart")
	assert(search.pattern("abc") == "(?i)abc", "lowercase ignores case")
	assert(search.pattern("Abc") == "Abc", "a capital minds it")
	local items = { "Abc", "abc" }
	local both = greed.fuzzy("abc", items, { case = search.case() })
	assert(#both == 2, `smart, lowercase: {#both}`)
	greed.option.set("search-case", "ignore")
	assert(search.pattern("Abc") == "(?i)Abc")
	assert(#greed.fuzzy("Abc", items, { case = search.case() }) == 2)
	t:buffer("|One one")
	t:keys("/ O n e enter")
	t:expect("One ^one|")
	greed.option.set("search-case", "match")
	assert(search.pattern("abc") == "abc")
	local exact = greed.fuzzy("abc", items, { case = search.case() })
	assert(#exact == 1 and exact[1] == 2, "only the one in that case")
	assert(#greed.fuzzy_positions("ABC", "abc", { case = "match" }) == 0)
	greed.option.set("search-case", "smart")
	assert(
		not pcall(greed.fuzzy :: any, "a", items, { case = "loud" }),
		"an unknown case is an error"
	)
end)

test("a kind of search minds case its own way, or as search-case says", function()
	local search = require("@core").search
	search.kind("testing", "ignore", "testing")
	assert(search.case("testing") == "ignore" and search.pattern("Abc", "testing") == "(?i)Abc")
	assert(search.case("nothing-made") == "smart", "a kind nobody made is as search-case says")
	greed.option.set("testing-search-case", "default")
	assert(search.case("testing") == "smart", "default leaves it to search-case")
	greed.option.set("search-case", "match")
	assert(search.case("testing") == "match" and search.pattern("abc", "testing") == "abc")
	greed.option.set("search-case", "smart")
	greed.option.set("testing-search-case", "ignore")
end)
