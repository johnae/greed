local test = require("@greed/test")
local greed = require("@greed")

test("a file changed on disk comes into its buffer, and u takes it back", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\ntwo\n" })
	greed.open(dir .. "/a.txt")
	local buffer = greed.view():buffer()
	greed.fs.write(dir .. "/a.txt", "one\nTWO\n")
	t:wait(600)
	assert(buffer:text() == "one\nTWO\n", buffer:text())
	assert(not buffer:modified())
	assert(buffer:history()[1].author == "external")
	t:keys("u")
	assert(buffer:text() == "one\ntwo\n", buffer:text())
end)

test("a buffer with unsaved changes is left alone, until :reload", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\n" })
	greed.open(dir .. "/a.txt")
	local buffer = greed.view():buffer()
	t:keys("i x esc")
	greed.fs.write(dir .. "/a.txt", "disk\n")
	t:wait(600)
	assert(buffer:text() == "xone\n", buffer:text())
	local messages = t:messages()
	assert(string.find(messages[#messages], "changed on disk", 1, true), messages[#messages])
	t:run("reload")
	assert(buffer:text() == "disk\n", buffer:text())
end)

test("saving doesn't count as a change on disk", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\n" })
	greed.open(dir .. "/a.txt")
	local buffer = greed.view():buffer()
	t:keys("i x esc")
	buffer:save()
	t:keys("i y esc")
	t:wait(600)
	assert(buffer:text() == "xyone\n", buffer:text())
	for _, message in t:messages() do
		assert(not string.find(message, "changed on disk", 1, true), message)
	end
end)
