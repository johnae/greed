local test = require("@greed/test")
local greed = require("@greed")
local pipe = require("@pipe")

test("luau filters change each selection", function(t)
	t:buffer("^fooBar| and ^some thing|")
	t:run("pipe", { "luau:", "snake_case" })
	t:expect("^foo_bar| and ^some_thing|")
	t:run("pipe", { "luau:", "upper" })
	t:expect("^FOO_BAR| and ^SOME_THING|")
	t:run("pipe", { "luau:", "camel_case" })
	t:expect("^fooBar| and ^someThing|")
end)

test("a shell command gets each selection as its input, and undo takes all back", function(t)
	t:buffer("^c\nb\na\n|")
	t:run("pipe", { "sort" })
	t:wait(100)
	assert(greed.view():buffer():text() == "a\nb\nc\n", greed.view():buffer():text())
	t:buffer("^one| ^two|")
	t:run("pipe", { "tr", "a-z", "A-Z" })
	t:wait(100)
	assert(greed.view():buffer():text() == "ONE TWO", "no line breaks added to words")
	t:keys("u")
	assert(greed.view():buffer():text() == "one two", "one undo takes back both")
end)

test("failures say why and change nothing", function(t)
	t:buffer("^text|")
	t:run("pipe", { "luau:", "nothing" })
	local messages = t:messages()
	assert(
		string.find(messages[#messages], "no Luau filter called nothing", 1, true),
		messages[#messages]
	)
	t:run("pipe", { "false" })
	t:wait(100)
	messages = t:messages()
	assert(string.find(messages[#messages], "false failed", 1, true), messages[#messages])
	assert(greed.view():buffer():text() == "text")
end)

test("plugins add filters of their own", function(t)
	pipe.define("shout", function(text)
		return text .. "!"
	end)
	t:buffer("^hey|")
	t:run("pipe", { "luau:", "shout" })
	t:expect("^hey!|")
end)

test("| asks what to pipe through", function(t)
	t:buffer("^abc|")
	t:keys("| l u a u : space u p p e r enter")
	t:expect("^ABC|")
end)

test("! and alt-! put a command's output before or after each selection", function(t)
	t:buffer("^ab| cd")
	t:run("insert-output", { "printf", "X" })
	t:expect("^X|ab cd")
	t:buffer("^ab| cd")
	t:run("append-output", { "printf", "X" })
	t:expect("ab^X| cd")
end)

test("$ keeps the selections a command succeeds on; alt-| leaves the text alone", function(t)
	t:buffer("^ok| ^no| ^ok|")
	t:run("keep-pipe", { "grep", "-q", "ok" })
	t:expect("^ok| no ^ok|")
	t:run("pipe-to", { "cat", ">/dev/null" })
	t:expect("^ok| no ^ok|")
end)

test("two pipes at once on one buffer each put their results in place", function(t)
	t:buffer("^one| two ^three|")
	local view = greed.view()
	local done: { [string]: string | boolean } = {}
	greed.spawn(function()
		local ok, err = pipe.pipe(view, "sleep 0.2; tr a-z A-Z")
		done.first = err or ok
	end)
	view:set_selection({ ranges = { { anchor = 4, head = 7 } }, primary = 1 })
	greed.spawn(function()
		local ok, err = pipe.pipe(view, "rev")
		done.second = err or ok
	end)
	t:wait_for(function()
		return done.first ~= nil and done.second ~= nil
	end, 5000)
	assert(done.first == true and done.second == true, `{done.first} {done.second}`)
	assert(view:buffer():text() == "ONE owt THREE", view:buffer():text())
end)
