local test = require("@kern/test")
local kern = require("@kern")
local pipe = require("@pipe")

test("luau filters change each selection", function(t)
	t:buffer("^fooBar| and ^some thing|")
	t:run("pipe", { "luau:", "snake_case" })
	t:expect("^foo_bar| and ^some_thing|")
	t:run("pipe", { "luau:", "upper" })
	t:expect("^FOO_BAR| and ^SOME_THING|")
	t:run("pipe", { "luau:", "camel_case" })
	t:expect("^fooBar| and ^someThing|")
end)

test("a shell command gets each selection as its input, and undo takes all back", function(t)
	t:buffer("^c\nb\na\n|")
	t:run("pipe", { "sort" })
	t:wait(100)
	assert(kern.view():buffer():text() == "a\nb\nc\n", kern.view():buffer():text())
	t:buffer("^one| ^two|")
	t:run("pipe", { "tr", "a-z", "A-Z" })
	t:wait(100)
	assert(kern.view():buffer():text() == "ONE TWO", "no line breaks added to words")
	t:keys("u")
	assert(kern.view():buffer():text() == "one two", "one undo takes back both")
end)

test("failures say why and change nothing", function(t)
	t:buffer("^text|")
	t:run("pipe", { "luau:", "nothing" })
	local messages = t:messages()
	assert(
		string.find(messages[#messages], "no Luau filter called nothing", 1, true),
		messages[#messages]
	)
	t:run("pipe", { "false" })
	t:wait(100)
	messages = t:messages()
	assert(string.find(messages[#messages], "false failed", 1, true), messages[#messages])
	assert(kern.view():buffer():text() == "text")
end)

test("plugins add filters of their own", function(t)
	pipe.define("shout", function(text)
		return text .. "!"
	end)
	t:buffer("^hey|")
	t:run("pipe", { "luau:", "shout" })
	t:expect("^hey!|")
end)

test("| asks what to pipe through", function(t)
	t:buffer("^abc|")
	t:keys("| l u a u : space u p p e r enter")
	t:expect("^ABC|")
end)
