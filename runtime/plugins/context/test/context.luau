local test = require("@greed/test")
local greed = require("@greed")
local context = require("@context")

test("space i p pins the selection, which follows edits, or the file", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\ntwo\nthree\n" })
	greed.project.open(dir)
	greed.open(dir .. "/a.txt")
	t:keys("j x space i p")
	local items = context.list()
	assert(#items == 1 and items[1].kind == "selection", "the line is pinned")
	t:keys("g g O n e w esc")
	local text, label = context.read(items[1])
	assert(text == "two\n", "it follows the text: " .. text)
	assert(label == "a.txt:3-3", label)
	t:keys("; space i p")
	assert(context.list()[2].kind == "file", "a cursor pins the whole file")
	assert(
		string.find(context.text(), "## a.txt\n\nnew\none\ntwo\nthree\n", 1, true),
		context.text()
	)
end)

test("space i i lists the items with sizes, and deleting a line drops one", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\n", ["b.txt"] = "two\n" })
	greed.project.open(dir)
	greed.open(dir .. "/a.txt")
	t:keys("space i p")
	greed.open(dir .. "/b.txt")
	t:keys("space i p")
	t:keys("space i i")
	local listed = greed.view():buffer():text()
	assert(listed == "a.txt  (1 tokens)\nb.txt  (1 tokens)", listed)
	t:keys("x d")
	assert(#context.list() == 1, "the first item is gone")
	local _, label = context.read(context.list()[1])
	assert(label == "b.txt", label)
	t:keys("q")
end)

test("computed items are worked out when read", function(t)
	t:tempdir({})
	local runs = 0
	context.define("count", function()
		runs += 1
		return `run {runs}`
	end)
	context.add({ kind = "computed", name = "count" })
	local first = context.text()
	assert(string.find(first, "## count\n\nrun 1", 1, true), first)
	assert(string.find(context.text(), "run 2", 1, true), "read fresh each time")
	t:run("context-clear")
	assert(#context.list() == 0)
end)

test("agents read the context with context_get", function(t)
	local dir = t:tempdir({ ["a.txt"] = "pinned text\n" })
	greed.project.open(dir)
	greed.open(dir .. "/a.txt")
	t:keys("space i p")
	local agent = require("@agent")
	for _, tool in agent.tools() do
		if tool.name == "context_get" then
			local answer = tool.run({}, agent.caller())
			assert(string.find(answer, "pinned text", 1, true), answer)
			return
		end
	end
	error("no context_get tool")
end)

test("any object pins to the context, read as it is each time, and goes to agents", function(t)
	local dir = t:tempdir({ ["a.txt"] = "one\n" })
	greed.project.open(dir)
	greed.open(dir .. "/a.txt")
	local core = require("@core")
	local buffer = greed.view():buffer()
	local id = `buffer:{buffer:id()}`
	local object = assert(core.objects.get(id))
	assert(core.objects.act(object, "pin to context"), "every kind can be pinned")
	assert(core.objects.act(object, "pin to context"))
	local items = context.list()
	assert(#items == 1 and items[1].kind == "object" and items[1].object == id, "pinned once")
	local before = context.text()
	assert(string.find(before, `## {id} (`, 1, true), before)
	assert(string.find(before, '"modified":false', 1, true), before)
	t:keys("i t w o esc")
	assert(string.find(context.text(), '"modified":true', 1, true), "read fresh")
	-- Every message to an agent carries it.
	local pinned = assert(require("@agent").context.pinned())
	assert(string.find(pinned, "<pinned-context>", 1, true) and string.find(pinned, id, 1, true))
	-- Gone, it says so.
	greed.view():show(greed.create_buffer("other", ""))
	buffer:close()
	assert(string.find(context.text(), "(it's gone)", 1, true), context.text())
	t:run("context-clear")
	assert(require("@agent").context.pinned() == nil, "nothing pinned, nothing sent")
end)

test("space i p in a buffer that isn't a file pins what's under the cursor", function(t)
	t:tempdir({})
	local scratch = greed.create_buffer("notes", "hello")
	greed.view():show(scratch)
	t:keys("space i p")
	local items = context.list()
	assert(
		#items == 1 and items[1].object == `buffer:{scratch:id()}`,
		tostring(items[1] and items[1].object)
	)
end)
