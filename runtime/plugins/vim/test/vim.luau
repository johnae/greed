test("; and , do the last f or t again, forward and back", function(t)
	buffer(t, "|a,b,c,d")
	t:keys("f , ;")
	t:expect("a,b|,c,d")
	t:keys(",")
	t:expect("a|,b,c,d")
	buffer(t, "|a,b,c")
	t:keys("t , ;")
