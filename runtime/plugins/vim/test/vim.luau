test('"A appends, p pastes what was copied elsewhere, "_ keeps nothing', function(t)
	buffer(t, "|one two")
	t:keys('" a y w w " A y w')
	t:keys('" a P')
	t:expect("one one tw|otwo")
	buffer(t, "|x")
	greed.clipboard.set("from outside")
	t:keys("p")
	t:expect("xfrom outsid|e")
	buffer(t, "|ab")
	t:keys('" _ x p')
	t:expect("bfrom outsid|e")
end)

test("5~ and 3J undo in one step; G and gg go in the jumplist", function(t)
	buffer(t, "|abcde")
	t:keys("5 ~ u")
	t:expect("|abcde")
	buffer(t, "|a\nb\nc")
	t:keys("3 J u")
	t:expect("|a\nb\nc")
	t:keys("G ctrl-o")
	t:expect("|a\nb\nc")
end)

test("panels keep their keys in the Vim style", function(t)
	buffer(t, "|x")
	greed.keymap.bind({ kind = "probe" }, { q = "goto-end" })
	greed.view():show(greed.create_buffer("probe", "text"))
	greed.mode.set("vim")
	local command = greed.keymap.resolve("q")
	assert(command == "goto-end", tostring(command))
end)

test("a picker takes typing in Vim's insert mode, and esc closes it", function(t)
	buffer(t, "|x")
	greed.option.set("editing-style", "vim")
	local chosen = nil
	require("@picker").pick("Test", { { label = "apple" }, { label = "banana" } }, function(item)
		chosen = item.label
	end)
	t:expect_mode("vim-insert")
	t:keys("b a n enter")
	assert(chosen == "banana", tostring(chosen))
	t:expect_mode("vim")
	require("@picker").pick("Test", { { label = "apple" } }, function() end)
	t:keys("esc")
	assert(#t:floats() == 0, "esc closed it")
	t:expect_mode("vim")
	greed.option.set("editing-style", "helix")
end)

test("W B E and ge move by WORDs and back to word ends", function(t)
	buffer(t, "|a.b c.d e")
	t:keys("W")
	t:expect("a.b |c.d e")
	t:keys("E")
	t:expect("a.b c.|d e")
	t:keys("B")
	t:expect("a.b |c.d e")
	t:keys("g e")
	t:expect("a.|b c.d e")
	buffer(t, "a.b c.|d")
	t:keys("g E")
	t:expect("a.|b c.d")
	buffer(t, "|a.b c")
	t:keys("d W")
	t:expect("|c")
end)

test("; and , do the last f or t again, forward and back", function(t)
	buffer(t, "|a,b,c,d")
	t:keys("f , ;")
	t:expect("a,b|,c,d")
	t:keys(",")
	t:expect("a|,b,c,d")
	buffer(t, "|a,b,c")
	t:keys("t , ;")
	t:expect("a,|b,c")
end)

test("{ } go between paragraphs, ( ) between sentences", function(t)
	buffer(t, "|one\ntwo\n\nthree\n\nfour")
	t:keys("}")
	t:expect("one\ntwo\n|\nthree\n\nfour")
	t:keys("}")
	t:expect("one\ntwo\n\nthree\n|\nfour")
	t:keys("{")
	t:expect("one\ntwo\n|\nthree\n\nfour")
	buffer(t, "|One. Two. Three.")
	t:keys(")")
	t:expect("One. |Two. Three.")
	t:keys(") (")
	t:expect("One. |Two. Three.")
end)

test("- + _ | and g_ go to lines and columns; counts for $ and %", function(t)
	buffer(t, "  a\n  b|x\n  c")
	t:keys("-")
	t:expect("  |a\n  bx\n  c")
	t:keys("+ +")
	t:expect("  a\n  bx\n  |c")
	t:keys("k 4 |")
	t:expect("  a\n  b|x\n  c")
	buffer(t, "|ab  \ncd")
	t:keys("g _")
	t:expect("a|b  \ncd")
	buffer(t, "|ab\ncd\nef")
	t:keys("2 $")
	t:expect("ab\nc|d\nef")
	t:keys("1 0 0 %")
	t:expect("ab\ncd\n|ef")
end)

test("H M and L go to the top, middle and bottom of the screen", function(t)
	local lines = {}
	for i = 0, 49 do
		table.insert(lines, `line {i}`)
	end
	buffer(t, "|" .. table.concat(lines, "\n"))
	t:draw(40, 11)
	t:keys("L")
	local view = greed.view()
	local function line(): number
		return view:buffer():line_of(view:selection().ranges[1].head)
	end
	assert(line() == 9, tostring(line()))
	t:keys("M")
	assert(line() == 4 or line() == 5, tostring(line()))
	t:keys("H")
	assert(line() == 0, tostring(line()))
end)

test("g~ gu gU and g? change case with a motion; u U ~ in visual mode", function(t)
	buffer(t, "|abc Def")
	t:keys("g U w")
	t:expect("|ABC Def")
	t:keys("g u u")
	t:expect("|abc def")
	t:keys("g ~ e")
	t:expect("|ABC def")
	t:keys("g ? i w")
	t:expect("|NOP def")
	buffer(t, "|abc")
	t:keys("v l U")
	t:expect("|ABc")
end)

test("gq rewraps lines to the text width, = indents them", function(t)
	greed.option.set("text-width", 10)
	buffer(t, "|one two three four")
	t:keys("g q q")
	t:expect("|one two\nthree four")
	greed.option.set("text-width", 80)
	buffer(t, "|one\ntwo")
	t:keys("g w j")
	t:expect("|one two")
end)

test('"0 keeps the last yank, "1 to "9 the last line deletes, "- a small one', function(t)
	buffer(t, "|keep\none\ntwo\nx y")
	t:keys("y y j d d d d w d w")
	t:keys('" 0 P')
	t:expect("keep\n|keep\nx ")
	buffer(t, "|a\nb\nc")
	t:keys("d d d d")
	t:keys('" 2 p')
	t:expect("c\n|a")
	buffer(t, "|ab cd")
	t:keys("d w")
	t:keys('" - P')
	t:expect("ab| cd")
end)

test("m sets a mark, ' goes to its line and ` to the mark itself, edits or not", function(t)
	buffer(t, "one\ntw|o\nthree")
	t:keys("m a g g")
	t:keys("O n e w esc")
	t:keys("` a")
	t:expect("new\none\ntw|o\nthree")
	t:keys("g g ' a")
	t:expect("new\none\n|two\nthree")
	t:keys("g g d ' a")
