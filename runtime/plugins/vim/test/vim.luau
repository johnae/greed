test("ctrl-o in insert mode runs one normal mode command, then goes on typing", function(t)
	buffer(t, "|one two")
	t:keys("A ! ctrl-o 0 > esc")
	t:expect("|>one two!")
	buffer(t, "|one two")
	t:keys("i ctrl-o d w x esc")
	t:expect("|xtwo")
end)

test("ctrl-t and ctrl-d indent and dedent the line while typing", function(t)
	buffer(t, "|a")
	t:keys("A ctrl-t b esc")
	t:expect("    a|b")
	t:keys("A ctrl-d c esc")
	t:expect("ab|c")
end)

test("ctrl-n and ctrl-p complete from words in open files", function(t)
	buffer(t, "alpha alpine\n|")
	t:keys("i a l ctrl-n enter esc")
	t:expect("alpha alpine\nalph|a")
	buffer(t, "alpha alpine\n|")
	t:keys("i a l ctrl-p enter esc")
	t:expect("alpha alpine\nalpin|e")
end)

test("g; and g, go back and forth through the places changes were made", function(t)
	buffer(t, "|a\nb\nc\nd")
	t:keys("x j j x G")
	t:expect("\nb\n\n|d")
	t:keys("g ;")
	t:expect("\nb\n|\nd")
	t:keys("g ;")
	t:expect("|\nb\n\nd")
	t:keys("g ,")
	t:expect("\nb\n|\nd")
end)

test("zf folds over a motion, zM folds everything, zj and zk go between folds", function(t)
	buffer(t, "|a\nb\nc\nd")
	t:keys("z f j")
	local hidden = greed.view():hidden_lines()
	assert(#hidden == 1 and hidden[1].from == 1 and hidden[1].to == 1, "zfj folds two lines")
	t:keys("z E")
	assert(#greed.view():hidden_lines() == 0)
	buffer(t, "|x\na:\n  b\nc:\n  d")
	t:keys("z M")
	assert(#greed.view():hidden_lines() == 2)
	t:keys("z E z j")
	t:expect("x\n|a:\n  b\nc:\n  d")
	t:keys("z j")
	t:expect("x\na:\n  b\n|c:\n  d")
	t:keys("z k")
	t:expect("x\na:\n|  b\nc:\n  d")
end)

test(": in visual mode fills in the selected lines' range; 3: the next three", function(t)
	buffer(t, "|a\nb\nc\nd")
	t:keys("V j : d enter")
	t:expect("|c\nd")
	t:expect_mode("vim")
	buffer(t, "|a\nb\nc\nd")
	t:keys("3 : d enter")
	t:expect("|d")
	buffer(t, "|ab\nab\nab")
	t:keys("ctrl-v j : s / a / x / enter")
	t:expect("xb\n|xb\nab")
end)

test("U puts back the line as it was before the changes made on it, and U again redoes", function(t)
	buffer(t, "|one two\nthree")
	t:keys("x x A ! esc")
	t:expect("e two|!\nthree")
	t:keys("U")
	t:expect("|one two\nthree")
	t:keys("U")
	t:expect("|e two!\nthree")
	t:keys("j x U")
	t:expect("e two!\n|three")
end)

test("i n and i l take the next or last pair, i i an indented block, i d a number", function(t)
	buffer(t, "|f(a) g(b)")
	t:keys("c i n ( x esc")
	t:expect("f(|x) g(b)")
	buffer(t, "f(a) g|(b)")
	t:keys("d a l (")
	t:expect("f| g(b)")
	buffer(t, "if x:\n  |a\n  b\nc")
	t:keys("d i i")
	t:expect("if x:\n|c")
	buffer(t, "|n = 42;")
	t:keys("c i d 7 esc")
	t:expect("n = |7;")
end)

test(
	"ys wraps a motion or object in a pair, ds takes one away, cs changes it, S in visual",
	function(t)
		buffer(t, "say |hello now")
		t:keys("y s i w )")
		t:expect("say |(hello) now")
		t:keys("c s ( ]")
		t:expect("say |[hello] now")
		t:keys("d s ]")
		t:expect("say |hello now")
		t:keys('y s s "')
		t:expect('|"say hello now"')
		buffer(t, "|ab cd")
		t:keys("v e S {")
		t:expect("|{ ab } cd")
		t:expect_mode("vim")
	end
)

test("K, grn, grr and the other Neovim language server keys are bound", function(t)
	buffer(t, "|x")
	assert(greed.keymap.resolve("K") == "hover")
	assert(greed.keymap.resolve("g r n") == "rename")
	assert(greed.keymap.resolve("g r r") == "goto-references")
	assert(greed.keymap.resolve("g r a") == "code-action")
	assert(greed.keymap.resolve("g r i") == "goto-implementation")
	assert(greed.keymap.resolve("g O") == "pick-outline")
end)

test("g s labels the words and puts the cursor on the start of the one typed", function(t)
	buffer(t, "|one two three")
	t:draw(40, 5)
	-- Nearest first: "one" under the cursor gets aa, "two" ab.
	t:keys("g s a b")
	t:expect_mode("vim")
	t:expect("one |two three")
end)

test("ctrl-n selects the word and its next matches; c types in every one", function(t)
	buffer(t, "|foo bar foo baz foo")
	t:keys("ctrl-n")
	t:expect_mode("vim-multi")
	t:keys("ctrl-n ctrl-n")
	assert(#greed.view():selection().ranges == 3, "three matches")
	t:keys("c x esc")
	-- As in vim-visual-multi, esc after typing keeps the cursors...
	t:expect("|x bar |x baz |x")
	t:expect_mode("vim-multi")
	t:keys("a y esc")
	t:expect("x|y bar x|y baz x|y")
	-- ... and esc again goes back to one.
	t:keys("esc")
	t:expect("xy bar xy baz x|y")
	t:expect_mode("vim")
	buffer(t, "|foo bar foo baz foo")
	t:keys("ctrl-n ctrl-n ctrl-x A ! esc esc")
	t:expect("foo! bar foo baz foo|!")
	buffer(t, "|ab ab")
	t:keys("ctrl-n ctrl-n ctrl-p d")
	t:expect("| ab")
end)

test("with motion-hints on, w numbers the next words and a digit moves there", function(t)
	greed.option.set("motion-hints", true)
	buffer(t, "|one two three four")
	t:keys("w 2")
	t:expect("one two three |four")
	buffer(t, "|one two three four")
	t:keys("v e 1")
	t:keys("d")
	t:expect("| three four")
	greed.option.set("motion-hints", false)
end)

test("lines copied in one style paste as lines in the others", function(t)
	buffer(t, "o|ne\ntwo")
	t:keys("y y")
	t:buffer("a|b\ncd")
	t:keys("p")
	t:expect("ab\n^one\n|cd")
	t:buffer("a|b\ncd")
	greed.mode.set("vscode")
	t:keys("ctrl-v")
	t:expect("one\na|b\ncd")

	-- The last line, though it has no line break.
	buffer(t, "ab\nl|ast")
	t:keys("y y")
	t:buffer("a|b")
	t:keys("p")
	t:expect("ab^\nlast|")
	buffer(t, "o|ne\ntwo")
	t:keys("y y")
	buffer(t, "a❯|")
	t:keys("p")
	t:expect("a❯\n|one")

	t:buffer("|line\nmore")
	t:keys("x y")
	buffer(t, "a|b\ncd")
	t:keys("P")
	t:expect("|line\nab\ncd")
end)

test("text copied outside Greed pastes as it is, even ending in a line break", function(t)
	buffer(t, "o|ne\ntwo")
	t:keys("y y")
	greed.clipboard.set("out\n")
	buffer(t, "a|b")
	t:keys("p")
	t:expect("about|\n")
	t:buffer("a|b")
	t:keys("p")
	t:expect("ab^out\n|")
	t:buffer("a|b")
	greed.mode.set("vscode")
	t:keys("ctrl-v")
	t:expect("aout\n|b")
end)

test("j and k keep the column on screen, across tabs and wide characters", function(t)
	buffer(t, "\tab|c\n1234567")
	t:keys("j")
	t:expect("\tabc\n123456|7")
	t:keys("k")
	t:expect("\tab|c\n1234567")
	buffer(t, "|界x\n1234")
	t:keys("l j")
	t:expect("界x\n12|34")
	t:keys("h k")
	t:expect("|界x\n1234")
end)

test(":q and :wq in a split close that window, as in Vim; the last one quits", function(t)
	local dir = t:tempdir({ ["a.txt"] = "a" })
	greed.open(dir .. "/a.txt")
	greed.mode.set("vim")
	t:keys(": s p enter")
	assert(#greed.tab.current().panes == 2)
	t:keys("i z esc : w q enter")
	assert(greed.fs.read(dir .. "/a.txt") == "za", (greed.fs.read(dir .. "/a.txt")))
	assert(#greed.tab.current().panes == 1 and not t:quitting(), "only the window closed")
	t:keys(": v s enter x : q enter")
	assert(#greed.tab.current().panes == 1 and not t:quitting(), ":q closes a window with changes")
	local ok = pcall(function()
		t:keys(": q enter")
	end)
	assert(not ok and not t:quitting(), "the last window refuses over unsaved changes")
	t:keys(": q a ! enter")
	assert(t:quitting())
end)

test("% off a bracket goes to the match of the next one on the line, as in Vim", function(t)
	buffer(t, "|if (a[1]) {")
	t:keys("%")
	t:expect("if (a[1]|) {")
	buffer(t, "x = |f(a) + g(b)")
	t:keys("%")
	t:expect("x = f(a|) + g(b)")
	buffer(t, "|x(a) y")
	t:keys("d %")
	t:expect("| y")
	-- Nothing on the rest of the line: it stays.
	buffer(t, "(a) |b\n(c)")
	t:keys("%")
	t:expect("(a) |b\n(c)")
end)

test("undo of :%s puts the cursor on the first line changed, as in Vim", function(t)
	buffer(t, "keep\n|a\nb a\nc\nd a")
	t:keys(": % s / a / z / g enter")
	t:expect("keep\nz\nb z\nc\n|d z")
	t:keys("u")
	t:expect("keep\n|a\nb a\nc\nd a")
end)

test("ctrl-n on an empty line says there's no word, and stays in normal mode", function(t)
	t:buffer("a\n|\nb")
	greed.option.set("editing-style", "vim")
	t:keys("ctrl-n")
	t:expect_mode("vim")
	assert(
		string.find(table.concat(t:messages(), "\n"), "no word under the cursor", 1, true) ~= nil
	)
	greed.option.set("editing-style", "helix")
end)
