local test = require("@kern/test")
local kern = require("@kern")

-- A buffer from `marked`, in Vim's normal mode.
local function buffer(t: any, marked: string)
	t:buffer(marked)
	kern.mode.set("vim")
end

test("hjkl move, keeping the column across lines", function(t)
	buffer(t, "|hello\nworld\nhi")
	t:keys("l l j")
	t:expect("hello\nwo|rld\nhi")
	t:keys("j")
	t:expect("hello\nworld\nh|i")
	t:keys("k k h")
	t:expect("h|ello\nworld\nhi")
end)

test("counts repeat motions", function(t)
	buffer(t, "|a\nb\nc\nd\ne")
	t:keys("3 j")
	t:expect("a\nb\nc\n|d\ne")
	t:keys("2 k")
	t:expect("a\n|b\nc\nd\ne")
	t:keys("G")
	t:expect("a\nb\nc\nd\n|e")
	t:keys("2 G")
	t:expect("a\n|b\nc\nd\ne")
	t:keys("g g")
	t:expect("|a\nb\nc\nd\ne")
end)

test("the cursor stays on a character, not past the end of the line", function(t)
	buffer(t, "|abc\nx")
	t:keys("$")
	t:expect("ab|c\nx")
	t:keys("l l")
	t:expect("ab|c\nx")
	t:keys("0")
	t:expect("|abc\nx")
end)

test("words: w b e", function(t)
	buffer(t, "|one two.three  four")
	t:keys("w")
	t:expect("one |two.three  four")
	t:keys("w")
	t:expect("one two|.three  four")
	t:keys("e")
	t:expect("one two.thre|e  four")
	t:keys("b b")
	t:expect("one two|.three  four")
end)

test("dw, d3w and 2dw delete words", function(t)
	buffer(t, "|one two three four five six")
	t:keys("d w")
	t:expect("|two three four five six")
	t:keys("d 3 w")
	t:expect("|five six")
	buffer(t, "|a b c d")
	t:keys("2 d w")
	t:expect("|c d")
end)

test("dd deletes lines, and p puts them back below", function(t)
	buffer(t, "one\n|two\nthree")
	t:keys("d d")
	t:expect("one\n|three")
	t:keys("p")
	t:expect("one\nthree\n|two")
	t:keys("g g 2 d d")
	t:expect("|two")
end)

test("ciw changes the word, cw changes to its end", function(t)
	buffer(t, "say he|llo there")
	t:keys("c i w")
	t:expect_mode("vim-insert")
	t:keys("b y e esc")
	t:expect_mode("vim")
	t:expect("say by|e there")
	t:keys("w c w")
	t:keys("w o r l d esc")
	t:expect("say bye worl|d")
	-- The change and what was typed undo as one step.
	t:keys("u")
	t:expect("say bye |there")
end)

test("f and t find characters on the line, with operators too", function(t)
	buffer(t, "|a,b,c;d")
	t:keys("f ,")
	t:expect("a|,b,c;d")
	t:keys("0 2 f ,")
	t:expect("a,b|,c;d")
	t:keys("0 d t ;")
	t:expect("|;d")
end)

test("x, D and . repeat", function(t)
	buffer(t, "|abcdef")
	t:keys("x")
	t:expect("|bcdef")
	t:keys(".")
	t:expect("|cdef")
	t:keys("l D")
	t:expect("|c")
end)

test("i a o O enter insert mode in the right place", function(t)
	buffer(t, "a|b")
	t:keys("i X esc")
	t:expect("a|Xb")
	t:keys("a Y esc")
	t:expect("aX|Yb")
	t:keys("o n e w esc")
	t:expect("aXYb\nne|w")
	t:keys("O u p esc")
	t:expect("aXYb\nu|p\nnew")
end)

test("visual mode selects and operates on characters", function(t)
	buffer(t, "|hello world")
	t:keys("v e")
	t:expect_mode("vim-visual")
	t:keys("d")
	t:expect_mode("vim")
	t:expect("| world")
	t:keys("P")
	t:expect("hell|o world")
end)

test("u and ctrl-r undo and redo", function(t)
	buffer(t, "|a b c")
	t:keys("d w d w")
	t:expect("|c")
	t:keys("2 u")
	t:expect("|a b c")
	t:keys("ctrl-r")
	t:expect("|b c")
end)

test("unloading it while in use goes back to Helix", function(t)
	buffer(t, "|one two")
	kern.option.set("editing-style", "vim")
	kern.plugin.unload("vim")
	t:expect_mode("normal")
	t:keys("w")
	-- Helix's w selects the word.
	t:expect("^one |two")
end)

test("keys from normal mode work here too: space, :, search", function(t)
	buffer(t, "|one two one")
	t:keys("/ o n e enter")
	-- The cursor lands on the match, as in Vim.
	t:expect("one two |one")
	t:expect_mode("vim")
	t:keys("n")
	t:expect("|one two one")
	t:keys("x")
	t:expect("|ne two one")
	-- Bound after Vim loaded, the way a later plugin would.
	kern.keymap.bind("normal", { ["space z"] = "goto-start" })
	t:keys("$ space z")
	t:expect("|ne two one")
	assert(kern.keymap.resolve("K") == nil, "Helix's own keys stay in Helix")
end)

test(":style switches between Helix, edit mode and Vim", function(t)
	buffer(t, "|abc")
	t:run("style", { "helix" })
	t:expect_mode("normal")
	t:keys("i x esc")
	t:expect_mode("normal")
	t:run("style", { "vim" })
	t:expect_mode("vim")
	t:keys("i y esc")
	t:expect_mode("vim")
	assert(not pcall(function()
		t:run("style", { "emacs" })
	end), "unknown styles are refused")
	t:expect_mode("vim")
	kern.option.set("editing-style", "helix")
	t:expect_mode("normal")
end)

test("ctrl-f, ctrl-b, ctrl-d and ctrl-u page through the file", function(t)
	local lines = {}
	for i = 0, 49 do
		table.insert(lines, `line {i}`)
	end
	buffer(t, "|" .. table.concat(lines, "\n"))
	t:draw(40, 11)
	t:keys("ctrl-f")
	assert(kern.view():scroll() == 10, tostring(kern.view():scroll()))
	t:draw(40, 11)
	t:keys("ctrl-u")
	assert(kern.view():scroll() == 5, tostring(kern.view():scroll()))
	t:expect_mode("vim")
end)

test("% jumps to the matching bracket, and works with operators", function(t)
	buffer(t, "|f(a, (b)) x")
	t:keys("l %")
	t:expect("f(a, (b)|) x")
	t:keys("%")
	t:expect("f|(a, (b)) x")
	t:keys("d %")
	t:expect("f| x")
end)

test("text objects: brackets, quotes and paragraphs", function(t)
	buffer(t, "f(a, |b) c")
	t:keys("d i (")
	t:expect("f(|) c")
	buffer(t, [[say "hel|lo" now]])
	t:keys([[c i " b y e esc]])
	t:expect([[say "by|e" now]])
	buffer(t, "f[a|b] c")
	t:keys("d a [")
	t:expect("f| c")
	buffer(t, "one\nt|wo\n\nthree")
	t:keys("d i p")
	t:expect("|\nthree")
end)

test("r replaces characters, ~ switches case and moves on", function(t)
	buffer(t, "|abc")
	t:keys("2 r x")
	t:expect("x|xc")
	buffer(t, "|aBc")
	t:keys("~ ~")
	t:expect("Ab|c")
end)

test("J joins lines, >> and << indent them, g c c comments them", function(t)
	buffer(t, "o|ne\n   two\nthree")
	t:keys("J")
	t:expect("one| two\nthree")
	buffer(t, "o|ne\ntwo")
	t:keys("> >")
	t:expect("    |one\ntwo")
	t:keys("< <")
	t:expect("|one\ntwo")
	buffer(t, "o|ne\ntwo")
	require("@core").comment.set("lua", "--")
	kern.view():buffer():set_language("lua")
	t:keys("g c c")
	t:expect("-- o|ne\ntwo")
end)

test("V selects whole lines, and operators take whole lines", function(t)
	buffer(t, "one\nt|wo\nthree\nfour")
	t:keys("V j d")
	t:expect("one\n|four")
	t:expect_mode("vim")
end)

test("* and # search for the word under the cursor", function(t)
	buffer(t, "|foo bar foo baz foo")
	t:keys("*")
	t:expect("foo bar |foo baz foo")
	t:keys("#")
	t:expect("|foo bar foo baz foo")
	t:expect_mode("vim")
end)

test("q records a macro into a register, @ plays it, @@ plays it again", function(t)
	buffer(t, "|a\nb\nc\nd")
	t:keys("q x I - esc j q")
	t:expect("-a\n|b\nc\nd")
	t:keys("@ x")
	t:expect("-a\n-b\n|c\nd")
	t:keys("@ @")
	t:expect("-a\n-b\n-c\n|d")
end)

test('"a y and "a p use a named register, and leave the unnamed one alone', function(t)
	buffer(t, "|one\ntwo")
	t:keys('" a y y j y y')
	t:keys('" a p')
	t:expect("one\ntwo\n|one")
	t:keys("p")
	t:expect("one\ntwo\none\n|two")
end)

test("yanking an empty line keeps the cursor on it", function(t)
	buffer(t, "a\n|\nb")
	t:keys("y y")
	t:expect("a\n|\nb")
end)

test("text objects from the syntax tree: functions, arguments, comments", function(t)
	require("@kern").syntax.set_query(
		"rust",
		"textobjects",
		"(function_item body: (_) @function.inside) @function.around (parameters (_) @parameter.around)"
	)
	buffer(t, "fn f(a: u8, |b: u8) {}\nfn g() {}")
	kern.view():buffer():set_language("rust")
	t:keys("d a a")
	t:expect("fn f(a: u8|) {}\nfn g() {}")
	t:keys("d a f")
	t:expect("|\nfn g() {}")
end)

test(". repeats whole changes: dd, dw, cw with its text, and visual d", function(t)
	buffer(t, "|one\ntwo\nthree\nfour")
	t:keys("d d .")
	t:expect("|three\nfour")
	buffer(t, "|aa bb cc dd")
	t:keys("d w .")
	t:expect("|cc dd")
	buffer(t, "|aa bb cc")
	t:keys("c w x esc w .")
	t:expect("x |x cc")
	buffer(t, "|abcdef")
	t:keys("v l d .")
	t:expect("|ef")
	buffer(t, "|a b c d")
	t:keys("d w 2 .")
