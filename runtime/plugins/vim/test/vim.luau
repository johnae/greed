test("W B E and ge move by WORDs and back to word ends", function(t)
	buffer(t, "|a.b c.d e")
	t:keys("W")
	t:expect("a.b |c.d e")
	t:keys("E")
	t:expect("a.b c.|d e")
	t:keys("B")
	t:expect("a.b |c.d e")
	t:keys("g e")
	t:expect("a.|b c.d e")
	buffer(t, "a.b c.|d")
	t:keys("g E")
	t:expect("a.|b c.d")
	buffer(t, "|a.b c")
