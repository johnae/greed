local test = require("@greed/test")
local greed = require("@greed")

-- A buffer from `marked`, in Vim's normal mode.
local function buffer(t: any, marked: string)
	t:buffer(marked)
	greed.mode.set("vim")
end

test("w, e and b go over CRLF line breaks", function(t)
	buffer(t, "|ab cd\r\nef")
	t:keys("w")
	t:expect("ab |cd\r\nef")
	t:keys("w")
	t:expect("ab cd\r\n|ef")
	t:keys("b b")
	t:expect("|ab cd\r\nef")
	t:keys("e e")
	t:expect("ab c|d\r\nef")
	t:keys("e")
	t:expect("ab cd\r\ne|f")
end)

test("W and E go over CRLF line breaks", function(t)
	buffer(t, "|a.b c,d\r\ne;f")
	t:keys("W W")
	t:expect("a.b c,d\r\n|e;f")
	t:keys("g g E E")
	t:expect("a.b c,|d\r\ne;f")
end)

test("w stops on an empty CRLF line", function(t)
	buffer(t, "|ab\r\n\r\ncd")
	t:keys("w")
	t:expect("ab\r\n|\r\ncd")
	t:keys("w")
	t:expect("ab\r\n\r\n|cd")
end)

test("dw at the end of a CRLF line keeps the line break", function(t)
	buffer(t, "ab |cd\r\nef")
	t:keys("d w")
	assert(greed.view():buffer():text() == "ab \r\nef", greed.view():buffer():text())
end)

test("word objects stop at a CRLF line break", function(t)
	buffer(t, "ab c|d\r\nef")
	t:keys("d i w")
	assert(greed.view():buffer():text() == "ab \r\nef", greed.view():buffer():text())
	buffer(t, "ab c|d  \r\nef")
	t:keys("d a w")
	assert(greed.view():buffer():text() == "ab \r\nef", greed.view():buffer():text())
end)

test("sentence objects stop at a CRLF line break", function(t)
	buffer(t, "One.\r\nTw|o.\r\nThree.")
	t:keys("d i s")
	assert(greed.view():buffer():text() == "One.\r\n\r\nThree.", greed.view():buffer():text())
	buffer(t, "On|e. Two.\r\nThree.")
	t:keys("d a s")
	assert(greed.view():buffer():text() == "Two.\r\nThree.", greed.view():buffer():text())
end)
