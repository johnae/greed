#!/usr/bin/env nu
# Writes runtime/plugins/languages/helix.luau from Helix's languages.toml:
# each language's file types, root files, comment token, indent and language
# servers, as Greed's language table has them. Greed's own entries come first;
# these fill in the languages it doesn't have. Helix is MPL-2.0, as Greed is.
#
#   nu dist/helix-languages.nu [COMMIT]
#
# COMMIT is a Helix commit (master's latest by default), named in the file.

def main [commit?: string] {
    let commit = ($commit | default (gh api repos/helix-editor/helix/commits/master --jq .sha | str trim))
    let toml = (http get --raw $"https://raw.githubusercontent.com/helix-editor/helix/($commit)/languages.toml" | from toml)
    let servers = $toml.language-server
    let entries = ($toml.language | each {|language| entry $language $servers } | str join "\n")
    let out = $"-- Generated by dist/helix-languages.nu from Helix's languages.toml at
-- ($commit) \(MPL-2.0, as Greed is\). Don't edit by hand: run it again.
-- Greed's own languages \(languages.luau\) come first; these fill in the rest.

return {
($entries)
}
"
    $out | save --force runtime/plugins/languages/helix.luau
    ^stylua runtime/plugins/languages/helix.luau
    print $"wrote ($toml.language | length) languages"
}

# `text` as a Luau string.
def quote [text: string] {
    let escaped = ($text | str replace --all '\' '\\' | str replace --all '"' '\"')
    $'"($escaped)"'
}

def list [items: list<string>] {
    $"{ ($items | each {|i| quote $i } | str join ', ') }"
}

# A comment token: one, or the first of a list, whose first is the usual
# one; null for none.
def first_of [value: any] {
    if ($value | describe | str starts-with "list") {
        if ($value | is-empty) { null } else { $value | first }
    } else { $value }
}

# One language as a Luau table field.
def entry [language: record, servers: record] {
    let types = ($language | get --optional file-types | default [])
    # Plain extensions, and globs that are a whole file name.
    let extensions = ($types | where ($it | describe) == "string")
    let names = ($types
        | where ($it | describe | str starts-with "record")
        | get glob
        | where ($it !~ '[*?\[{/]'))
    let roots = ($language | get --optional roots | default [])
    let commands = ($language
        | get --optional language-servers
        | default []
        | each {|s| if ($s | describe | str starts-with "record") { $s.name } else { $s } }
        | each {|name| $servers | get --optional $name }
        | where $it != null
        | each {|s| [$s.command] | append ($s | get --optional args | default []) })
    let comment = (first_of ($language | get --optional comment-token)
        | default (first_of ($language | get --optional comment-tokens)))
    let indent = ($language | get --optional indent)
    mut fields = []
    if ($extensions | is-not-empty) { $fields = ($fields | append $"extensions = (list $extensions)") }
    if ($names | is-not-empty) { $fields = ($fields | append $"names = (list $names)") }
    if ($roots | is-not-empty) { $fields = ($fields | append $"roots = (list $roots)") }
    if ($commands | is-not-empty) {
        let all = ($commands | each {|c| list $c } | str join ', ')
        $fields = ($fields | append $"servers = { ($all) }")
    }
    if ($comment != null) { $fields = ($fields | append $"comment = (quote $comment)") }
    if ($indent != null) {
        if ($indent.unit | str contains "\t") {
            $fields = ($fields | append $"tab_width = ($indent.tab-width)")
        } else {
            $fields = ($fields | append $"indent = ($indent.unit | str length)")
        }
    }
    let body = ($fields | each {|f| $"\t\t($f)," } | str join "\n")
    $"\t[(quote $language.name)] = {\n($body)\n\t},"
}
